---
import Layout from '../../layouts/Layout.astro';
import { fetchDrops } from '../../lib/drop';
import { SPAM_AVISO } from '../../lib/avisos';

export const prerender = false;

const { drop } = await fetchDrops();
const WHATSAPP_URL = drop?.whatsapp_url || 'https://chat.whatsapp.com/JI022Gqv3szBEKCcNBMEwN';
const INSTAGRAM_URL = drop?.instagram_url || 'https://www.instagram.com/tyer_br';
const YOUTUBE_URL = 'https://www.youtube.com/@tyer_br';
---

<Layout title="Você está na lista" description="Obrigado pelo interesse na Tyer." lang="pt" noindex bodyClass="page-drop">
  <section class="thanks">
    <div class="thanks__anim" aria-hidden="true">
      <img class="thanks__gif" src="/obrigado.gif" alt="" width="220" height="220" onerror="this.remove()" />
      <span class="thanks__ring"></span>
      <svg class="thanks__check" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"></path></svg>
    </div>
    <h1 class="thanks__title">Valeu pelo interesse!</h1>
    <p class="thanks__text">
      Seu e-mail está na lista{drop ? <> do drop <strong>{drop.title}</strong></> : ''}. Avisamos por e-mail e, antes, na comunidade: entre no grupo e acompanhe a Tyer nas redes.
      {SPAM_AVISO}
    </p>
    <a class="thanks__cta" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">Entrar no grupo do WhatsApp</a>
    <ul class="thanks__social" role="list" aria-label="Redes da Tyer">
      <li><a href={INSTAGRAM_URL} target="_blank" rel="noopener noreferrer"><img src="/icons/instagram.svg" alt="" width="28" height="28" />Instagram</a></li>
      <li><a href={YOUTUBE_URL} target="_blank" rel="noopener noreferrer"><img src="/icons/youtube.svg" alt="" width="28" height="28" />YouTube</a></li>
    </ul>
    <a class="thanks__back" href="/">Voltar para o início</a>
  </section>
</Layout>

<style>
  .thanks { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding: 120px 20px 80px; text-align: center; background: #0b0b0b; color: #fff; }
  .thanks__anim { position: relative; display: grid; place-items: center; width: 160px; height: 160px; color: var(--c-accent, #e77e23); }
  .thanks__gif { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .thanks__ring { position: absolute; inset: 0; border: 3px solid currentColor; border-radius: 50%; animation: thanks-pop 0.7s ease-out both, thanks-pulse 2.4s ease-in-out 0.8s infinite; }
  .thanks__check { stroke-dasharray: 30; stroke-dashoffset: 30; animation: thanks-draw 0.6s ease-out 0.4s forwards; }
  .thanks__title { margin: 0; font-family: var(--font-title); font-size: clamp(40px, 8vw, 72px); line-height: 0.95; text-transform: uppercase; }
  .thanks__text { margin: 0; max-width: 520px; font-size: 16px; line-height: 1.6; color: rgba(255, 255, 255, 0.8); }
  .thanks__cta { padding: 16px 28px; border-radius: 8px; background: var(--c-accent, #e77e23); color: #fff; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; font-size: 13px; text-decoration: none; }
  .thanks__social { list-style: none; margin: 4px 0 0; padding: 0; display: flex; gap: 24px; }
  .thanks__social a { display: inline-flex; align-items: center; gap: 8px; color: #fff; font-weight: 700; text-decoration: none; }
  .thanks__social img { filter: brightness(0) invert(1); }
  .thanks__back { color: rgba(255, 255, 255, 0.55); font-size: 13px; }
  @keyframes thanks-pop { from { transform: scale(0.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes thanks-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(231, 126, 35, 0.45); } 50% { box-shadow: 0 0 0 18px rgba(231, 126, 35, 0); } }
  @keyframes thanks-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .thanks__ring, .thanks__check { animation: none; stroke-dashoffset: 0; } }
</style>
