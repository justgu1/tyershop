---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { SPAM_AVISO } from '../lib/avisos';
import { getLangFromUrl, t, getPathForLang } from '../i18n/utils';
import type { Lang } from '../i18n/utils';

const lang: Lang = getLangFromUrl(Astro.url);
const c = (key: string) => t(lang, 'checkout', key);
---

<Layout title={c('title')} lang={lang} noindex bodyClass="checkout-page" bare>
  <div class="checkout-shell" id="checkout-root"
    data-mobile-step="contact"
    data-error-fields={c('error_fields')}
    data-error-generic={c('error_generic')}
    data-preparing={c('preparing')}
    data-continue-to-payment={c('continue_to_payment')}
    data-pay-button={c('pay_button')}
    data-processing={c('processing')}
    data-pix-copy={c('pix_copy')}
    data-pix-copied={c('pix_copied')}
    data-pix-generate={c('pix_generate')}
  >
    <header class="checkout-topbar">
      <a href={getPathForLang('/cart', lang)} class="checkout-topbar__back" aria-label={c('back_to_cart')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        <span>{c('back_to_cart').replace(/^←\s*/, '')}</span>
      </a>
      <a href={getPathForLang('/', lang)} class="checkout-topbar__logo">TYER</a>
      <div class="checkout-topbar__lock" id="checkout-lock-indicator" hidden>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <span>Pagamento seguro via Mercado Pago</span>
      </div>
    </header>

    <div class="checkout-shell__body">
      <div class="checkout-main">
        <p id="checkout-empty" class="checkout-page__empty" hidden>{c('empty')}</p>

        <!-- Wizard por passo só no mobile (≤860px) — no desktop fica vazio
             visualmente (display:none fora do media query) e não afeta nada. -->
        <div class="checkout-mobile-stepper" id="checkout-mobile-stepper">
          <div class="checkout-mobile-stepper__bar">
            <div class="checkout-mobile-stepper__fill" id="checkout-mobile-stepper-fill"></div>
          </div>
          <div class="checkout-mobile-stepper__meta">
            <p id="checkout-mobile-step-label" class="checkout-mobile-step-label" aria-live="polite">
              Passo 1 de 3 — Seus dados
            </p>
            <span class="checkout-mobile-stepper__pct" id="checkout-mobile-stepper-pct">33%</span>
          </div>
        </div>

        <div id="checkout-form-section">
          <div class="checkout-step-wrap" id="checkout-step-wrap">
            <form id="checkout-contact-form">
              <section id="checkout-contact-section" class="checkout-step">
                <h2 class="checkout-step__title">{c('contact_title')}</h2>

                <!-- Cliente logado com dados já conhecidos: cartão-resumo em
                     vez do form cru, só "Avançar" (ou "Editar" pra corrigir
                     algo antes de seguir). Inputs abaixo continuam no DOM
                     (preenchidos via JS) — payerFromForm()/validação não mudam. -->
                <div id="checkout-contact-summary" class="checkout-account-card" hidden>
                  <div class="checkout-account-card__info">
                    <p class="checkout-account-card__name" id="checkout-contact-summary-name"></p>
                    <p class="checkout-account-card__detail" id="checkout-contact-summary-email"></p>
                  </div>
                  <button type="button" id="checkout-contact-summary-edit" class="checkout-address-overlay__edit">
                    Editar
                  </button>
                </div>

                <div id="checkout-contact-fields">
                  <div class="checkout-grid">
                    <label class="checkout-field checkout-field--full">
                      <span>{c('email')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-email" name="email" type="email" required autocomplete="email" />
                      <span class="checkout-field__error" data-error-for="ck-email" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>{c('first_name')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-first-name" name="given-name" type="text" required autocomplete="given-name" />
                      <span class="checkout-field__error" data-error-for="ck-first-name" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>{c('last_name')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-last-name" name="family-name" type="text" required autocomplete="family-name" />
                      <span class="checkout-field__error" data-error-for="ck-last-name" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>{c('cpf')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-cpf" name="cpf" type="text" inputmode="numeric" placeholder="000.000.000-00" required autocomplete="off" />
                      <span class="checkout-field__error" data-error-for="ck-cpf" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>{c('phone')}</span>
                      <input id="ck-phone" name="tel" type="tel" placeholder="(00) 00000-0000" autocomplete="tel" />
                    </label>
                  </div>
                  <p id="checkout-personal-error" class="checkout-error" hidden></p>
                </div>
                <button type="button" id="checkout-contact-continue" class="checkout-step__continue">
                  Continuar
                </button>
              </section>

              <section id="checkout-address-section" class="checkout-step">
                <button type="button" id="checkout-address-back" class="checkout-step__back">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                  Voltar
                </button>
                <h2 class="checkout-step__title">{c('address_title')}</h2>

                <!-- Cliente logado com endereço(s) já salvos: cartão por
                     endereço (escolhe um, clique seleciona) em vez do form
                     cru, com "Avançar" e uma saída pra cadastrar um novo. -->
                <div id="checkout-address-summary" class="checkout-account-card checkout-account-card--addresses" hidden>
                  <div class="checkout-address-cards" id="checkout-address-cards"></div>
                  <button type="button" id="checkout-address-summary-edit" class="checkout-link-btn">
                    Editar este endereço
                  </button>
                  <button type="button" id="checkout-address-summary-delete" class="checkout-link-btn checkout-link-btn--danger">
                    Excluir este endereço
                  </button>
                  <button type="button" id="checkout-address-summary-new" class="checkout-link-btn">
                    Usar outro endereço
                  </button>
                </div>

                <div id="checkout-address-fields">
                  <div class="checkout-grid">
                    <div class="checkout-address-row">
                    <label class="checkout-field">
                      <span>{c('street_name')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-street" name="address-line1" type="text" required autocomplete="address-line1" />
                      <span class="checkout-field__error" data-error-for="ck-street" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>{c('street_number')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-number" name="address-line2" type="text" required autocomplete="address-line2" />
                      <span class="checkout-field__error" data-error-for="ck-number" hidden></span>
                    </label>
                    </div>
                    <label class="checkout-field">
                      <span>{c('zip_code')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-zip" name="postal-code" type="text" inputmode="numeric" placeholder="00000-000" required autocomplete="postal-code" />
                      <span class="checkout-field__error" data-error-for="ck-zip" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>Complemento</span>
                      <input id="ck-complement" name="address-line3" type="text" maxlength="60" placeholder="Apto, bloco, casa…" autocomplete="address-line3" />
                    </label>
                    <label class="checkout-field">
                      <span>{c('neighborhood')}</span>
                      <input id="ck-neighborhood" name="neighborhood" type="text" autocomplete="off" />
                    </label>
                    <label class="checkout-field">
                      <span>{c('city')} <em class="checkout-field__required">*</em></span>
                      <input id="ck-city" name="address-level2" type="text" required autocomplete="address-level2" />
                      <span class="checkout-field__error" data-error-for="ck-city" hidden></span>
                    </label>
                    <label class="checkout-field">
                      <span>{c('province')} <em class="checkout-field__required">*</em></span>
                      <select id="ck-province" name="address-level1" required autocomplete="address-level1"><option value="">UF</option><option value="AC">AC</option><option value="AL">AL</option><option value="AP">AP</option><option value="AM">AM</option><option value="BA">BA</option><option value="CE">CE</option><option value="DF">DF</option><option value="ES">ES</option><option value="GO">GO</option><option value="MA">MA</option><option value="MT">MT</option><option value="MS">MS</option><option value="MG">MG</option><option value="PA">PA</option><option value="PB">PB</option><option value="PR">PR</option><option value="PE">PE</option><option value="PI">PI</option><option value="RJ">RJ</option><option value="RN">RN</option><option value="RS">RS</option><option value="RO">RO</option><option value="RR">RR</option><option value="SC">SC</option><option value="SP">SP</option><option value="SE">SE</option><option value="TO">TO</option></select>
                      <span class="checkout-field__error" data-error-for="ck-province" hidden></span>
                    </label>
                  </div>
                </div>

                <div id="checkout-address-edit-actions" class="checkout-address-actions" hidden>
                  <button type="button" id="checkout-address-save" class="btn btn-primary">Salvar endereço</button>
                  <button type="button" id="checkout-address-cancel" class="btn btn-outline">Cancelar</button>
                  <p id="checkout-address-edit-error" class="checkout-error" hidden></p>
                </div>

                <div id="ck-shipping" class="checkout-shipping" hidden>
                  <h2 class="checkout-step__title">Entrega</h2>
                  <p id="ck-ship-hint" class="checkout-hint" role="status"></p>
                  <div class="ship-opts" id="ck-ship-options" aria-live="polite"></div>
                </div>

                <div id="checkout-login-needed" class="checkout-login-needed" hidden>
                  <p>Esse e-mail já tem conta na Tyer. Digite sua senha pra continuar.</p>
                  <label class="checkout-field">
                    <span>Senha</span>
                    <input id="ck-login-password" type="password" autocomplete="current-password" />
                  </label>
                  <button type="button" id="ck-forgot-password" class="checkout-link-btn">Esqueci minha senha</button>
                  <p id="ck-forgot-status" class="checkout-hint" hidden></p>
                </div>

                <p id="checkout-contact-error" class="checkout-error" hidden></p>
              </section>
            </form>

            <!-- Depois de confirmado: overlay trava a esquerda por cima do formulário
                 (continua visível por baixo, só desabilitado) — pagamento libera à direita. -->
            <div id="checkout-address-overlay" class="checkout-address-overlay" hidden>
              <div class="checkout-address-overlay__card">
                <svg class="checkout-address-overlay__lock" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <div class="checkout-address-overlay__info">
                  <p class="checkout-address-overlay__name" id="checkout-locked-name"></p>
                  <p class="checkout-address-overlay__lines" id="checkout-locked-address"></p>
                </div>
                <button type="button" id="checkout-edit-address" class="checkout-address-overlay__edit">
                  Editar
                </button>
              </div>
            </div>
          </div>
        </div>

        <div id="checkout-busy" class="checkout-busy" role="status" aria-live="polite" hidden>
          <div class="checkout-busy__card">
            <div class="checkout-busy__stage" aria-hidden="true">
              <svg class="checkout-busy__ball" width="56" height="56" viewBox="0 0 56 56" fill="none">
                <circle cx="28" cy="28" r="25" fill="#e77e23" />
                <g stroke="#0b0b0b" stroke-width="2.2" stroke-linecap="round">
                  <path d="M28 3v50M3 28h50" />
                  <path d="M9 9c10 8 10 30 0 38M47 9c-10 8-10 30 0 38" />
                </g>
              </svg>
              <span class="checkout-busy__shadow"></span>
            </div>
            <div class="checkout-busy__bar" aria-hidden="true"><span></span></div>
            <p class="checkout-busy__text" id="checkout-busy-text"></p>
            <p class="checkout-busy__hint">Não feche esta página.</p>
          </div>
        </div>

        <div id="checkout-success" class="checkout-success" hidden>
          <div class="checkout-success__anim" aria-hidden="true">
            <span class="checkout-success__ring"></span>
            <svg class="checkout-success__check" width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"></path></svg>
          </div>
          <h2>{c('success_title')}</h2>
          <p class="checkout-success__order" id="checkout-success-order" hidden></p>
          <p>{c('success_text')}</p>
          <ul class="checkout-success__items" id="checkout-success-items" role="list"></ul>
          <p class="checkout-success__total" id="checkout-success-total" hidden></p>
          <p class="checkout-success__mail" id="checkout-success-mail" hidden></p>
          <p class="checkout-success__spam" id="checkout-success-spam" hidden>{SPAM_AVISO}</p>
          <div class="checkout-success__actions">
            <a href={getPathForLang('/account/orders', lang)} class="btn btn-primary">Ver meus pedidos</a>
            <a href={getPathForLang('/', lang)} class="btn btn-outline">Voltar ao início</a>
          </div>
          <ul class="checkout-success__social" role="list" aria-label="Redes da Tyer">
            <li><a href="https://chat.whatsapp.com/JI022Gqv3szBEKCcNBMEwN" target="_blank" rel="noopener noreferrer">Grupo do WhatsApp</a></li>
            <li><a href="https://www.instagram.com/tyer_br" target="_blank" rel="noopener noreferrer">Instagram</a></li>
            <li><a href="https://www.youtube.com/@tyer_br" target="_blank" rel="noopener noreferrer">YouTube</a></li>
          </ul>
        </div>
      </div>

      <aside class="checkout-summary" id="checkout-summary-panel">
        <button type="button" class="checkout-summary__toggle" id="checkout-summary-toggle" aria-expanded="true">
          <span class="checkout-summary__toggle-label">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            {t(lang, 'cart', 'summary')}
          </span>
          <span class="checkout-summary__toggle-total" id="checkout-summary-toggle-total">—</span>
        </button>

        <div class="checkout-summary__body" id="checkout-summary-body">
          <div class="checkout-summary__items" id="checkout-summary-items"></div>
        </div>

        <!-- Fora da área com scroll de propósito: subtotal/frete/desconto
             precisam ficar visíveis junto com o Total, sem depender de rolar
             a lista de itens até o fim pra ver os valores. -->
        <div class="checkout-summary__totals">
          <div class="checkout-summary__row">
            <span>{t(lang, 'cart', 'subtotal')}</span>
            <span id="checkout-summary-subtotal">—</span>
          </div>
          <div class="checkout-summary__row" id="checkout-summary-discount-row" hidden>
            <span>Desconto</span>
            <span id="checkout-summary-discount">—</span>
          </div>
          <div class="checkout-summary__row" id="checkout-summary-shipping-row" hidden>
            <span>{c('shipping')}</span>
            <span id="checkout-summary-shipping">—</span>
          </div>
        </div>

        <!-- Pagamento: só aparece depois que endereço trava -->
        <div id="checkout-payment-block" class="checkout-payment-block" hidden>
          <button type="button" id="checkout-payment-back" class="checkout-payment-block__back">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            Voltar
          </button>
          <div class="checkout-tabs" role="tablist">
            <button type="button" class="checkout-tab is-active" data-payment-tab="card">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
              {c('method_card')}
            </button>
            <button type="button" class="checkout-tab" data-payment-tab="pix">
              <svg width="16" height="16" viewBox="0 0 316 300" aria-hidden="true"><path d="M246.13,234.5A46.07,46.07,0,0,1,213.35,221L166,173.6a9,9,0,0,0-12.44,0l-47.51,47.5A46.09,46.09,0,0,1,73.27,234.7H64l60,60a48,48,0,0,0,67.81,0l60.12-60.13Z" fill="#32bcad"/><path d="M73.28,67.1a46.08,46.08,0,0,1,32.78,13.57l47.51,47.52a8.81,8.81,0,0,0,12.44,0l47.34-47.34a46,46,0,0,1,32.78-13.58h5.7L191.71,7.15a47.94,47.94,0,0,0-67.81,0L64,67.1Z" fill="#32bcad"/><path d="M301.56,117l-36.33-36.33a7,7,0,0,1-2.58.52H246.13a32.62,32.62,0,0,0-22.93,9.5L175.86,138a22.74,22.74,0,0,1-32.13,0L96.21,90.5A32.62,32.62,0,0,0,73.28,81H53a7.12,7.12,0,0,1-2.44-.49L14,117a48,48,0,0,0,0,67.81l36.48,36.48a6.85,6.85,0,0,1,2.44-.49H73.28a32.63,32.63,0,0,0,22.93-9.51l47.51-47.51c8.59-8.58,23.56-8.58,32.14,0l47.34,47.33a32.62,32.62,0,0,0,22.93,9.5h16.52a6.9,6.9,0,0,1,2.58.52l36.33-36.33a47.94,47.94,0,0,0,0-67.81" fill="#32bcad"/></svg>
              {c('method_pix')}
            </button>
          </div>

          <div data-payment-panel="card">
            <form id="checkout-card-form" class="checkout-card-form">
              <label class="checkout-field checkout-field--full">
                <span>{c('card_number')}</span>
                <div id="ck-card-number" class="checkout-secure-field"></div>
              </label>
              <div class="checkout-grid checkout-grid--card">
                <label class="checkout-field">
                  <span>{c('card_expiration')}</span>
                  <div id="ck-card-expiration" class="checkout-secure-field"></div>
                </label>
                <label class="checkout-field">
                  <span>{c('card_cvv')}</span>
                  <div id="ck-card-cvv" class="checkout-secure-field"></div>
                </label>
              </div>
              <label class="checkout-field checkout-field--full">
                <span>{c('card_holder_name')}</span>
                <input id="ck-card-holder" type="text" required />
              </label>
              <div class="checkout-field">
                <span id="ck-installments-label">{c('installments')}</span>
                <!-- Dropdown custom (não é <select> nativo, mas mantém o
                     mesmo padrão de combobox/listbox acessível: botão com
                     aria-haspopup/expanded, lista role=listbox/option,
                     teclado — o valor de verdade fica no input hidden,
                     lido do mesmo jeito de antes por checkout-client.ts). -->
                <div class="ck-select" id="ck-installments-select">
                  <button
                    type="button"
                    class="ck-select__btn"
                    id="ck-installments-btn"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                    aria-labelledby="ck-installments-label ck-installments-btn"
                  >
                    <span class="ck-select__value" id="ck-installments-value">1x</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                  <ul class="ck-select__list" id="ck-installments-list" role="listbox" aria-labelledby="ck-installments-label" tabindex="-1" hidden>
                    <li role="option" data-value="1" aria-selected="true" class="is-selected">1x</li>
                    <li role="option" data-value="2" aria-selected="false">2x</li>
                    <li role="option" data-value="3" aria-selected="false">3x</li>
                    <li role="option" data-value="6" aria-selected="false">6x</li>
                  </ul>
                </div>
                <input type="hidden" id="ck-installments" value="1" />
              </div>
              <p id="checkout-card-error" class="checkout-error" hidden></p>
            </form>
          </div>

          <div data-payment-panel="pix" hidden>
            <div id="checkout-pix-form">
              <p class="checkout-hint">{c('pix_intro')}</p>
              <p id="checkout-pix-error" class="checkout-error" hidden></p>
            </div>
            <div id="checkout-pix-result" hidden>
              <div id="checkout-pix-live">
                <p class="checkout-pix-timer">Este código expira em <strong id="checkout-pix-countdown">--:--</strong></p>
                <img id="checkout-pix-qr" alt="QR code Pix" class="checkout-pix-qr" />
                <textarea id="checkout-pix-code" class="checkout-pix-code" readonly rows="3"></textarea>
                <button id="checkout-pix-copy" type="button" class="btn btn-outline">{c('pix_copy')}</button>
                <p class="checkout-waiting">{c('pix_waiting')}</p>
              </div>
              <div id="checkout-pix-expired" class="checkout-pix-expired" hidden>
                <p>O código Pix expirou. Gere um novo para pagar.</p>
                <button id="checkout-pix-renew" type="button" class="btn btn-primary">Gerar novo código</button>
              </div>
            </div>
          </div>

        </div>

        <div class="checkout-summary__total-row">
          <span>{t(lang, 'cart', 'total')}</span>
          <span id="checkout-summary-total">—</span>
        </div>
        <button type="button" id="checkout-summary-cta" class="btn btn-primary checkout-summary__cta">
          {c('continue_to_payment')}
        </button>
      </aside>
    </div>
  </div>
</Layout>

<script id="mp-sdk" is:inline src="https://sdk.mercadopago.com/js/v2"></script>
<script>
  import '../scripts/checkout-client';
</script>

<style>
  :global(body.checkout-page) {
    height: 100vh;
    overflow: hidden;
  }
  :global(body.checkout-page #main-content) {
    height: 100vh;
    background: #0a0a0a;
    /* `main{padding-top:var(--header-h)}` (Layout.astro) reserva espaço pro
       Header fixo do site — checkout usa `bare` (sem Header), então essa
       reserva sobrava como um vão vazio em cima do topbar, e ainda dava
       scroll de sobra (altura real = 100vh + esse padding). */
    padding-top: 0;
  }
  .checkout-shell {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: #0a0a0a;
  }
  .checkout-shell__body {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: 1fr 400px;
  }
  /* Pedido confirmado: sem o resumo ao lado, a página vira uma coluna só e o aviso fica no centro. */
  .checkout-shell.is-done .checkout-shell__body {
    grid-template-columns: minmax(0, 1fr);
  }
  .checkout-shell.is-done .checkout-success {
    max-width: 640px;
    margin: 0 auto;
  }

  /* Grid de 3 colunas em vez de flex + margin-inline:auto: a logo fica no
     centro de verdade da barra, não só no espaço livre entre os vizinhos
     (que mudam de largura quando o cadeado aparece/some). */
  .checkout-topbar {
    flex: 0 0 auto;
    height: 64px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    padding-inline: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .checkout-topbar__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #b8b8b8;
    text-decoration: none;
    font-size: 13px;
    white-space: nowrap;
    justify-self: start;
  }
  .checkout-topbar__back:hover {
    color: #fff;
  }
  .checkout-topbar__logo {
    font-family: var(--font-title);
    font-size: 18px;
    letter-spacing: 0.04em;
    color: #fff;
    text-decoration: none;
    justify-self: center;
  }
  .checkout-topbar__lock {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: #7dd88a;
    white-space: nowrap;
    justify-self: end;
  }
  /* `display:flex` acima é regra de autor e ganha do `[hidden]` da UA
     stylesheet — sem isso o cadeado fica sempre visível mesmo com o
     atributo `hidden` setado. */
  .checkout-topbar__lock[hidden] {
    display: none !important;
  }

  .checkout-main {
    overflow-y: auto;
    padding: 32px 40px 60px;
  }
  /* Indicador de passo e botão "Voltar" do pagamento só existem pro wizard
     mobile — no desktop as 2 colunas já mostram tudo, sem passo a passo. */
  .checkout-mobile-stepper {
    display: none;
  }
  .checkout-payment-block__back {
    display: none;
  }
  .checkout-page__empty {
    color: #b8b8b8;
  }
  .checkout-step {
    max-width: 560px;
  }
  .checkout-step__title {
    font-family: var(--font-title);
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 16px;
    color: #fff;
  }
  .checkout-step__title:not(:first-child) {
    margin-top: 24px;
  }
  /* "Continuar"/"Voltar" entre os passos de dados/endereço só existem no
     wizard mobile — no desktop as 2 seções ficam sempre visíveis juntas. */
  .checkout-step__continue {
    display: none;
  }
  .checkout-step__back {
    display: none;
  }
  .checkout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .checkout-grid--card {
    grid-template-columns: 1fr 1fr;
  }
  .checkout-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 12px;
    color: #b8b8b8;
  }
  .checkout-field--full {
    grid-column: 1 / -1;
  }
  .checkout-field input,
  .checkout-field select {
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-md, 8px);
    padding: 10px 12px;
    color: #fff;
    font-size: 14px;
  }
  .checkout-field input:focus,
  .checkout-field select:focus {
    outline: none;
    border-color: var(--c-accent);
  }
  .checkout-field__required {
    color: var(--c-accent);
    font-style: normal;
  }
  .checkout-field__error {
    font-size: 11px;
    color: #fca5a5;
  }
  .checkout-field__error[hidden] {
    display: none !important;
  }
  .checkout-field.is-invalid input {
    border-color: #f87171;
  }
  /* Dropdown de parcelas — mesmo visual dos outros campos (`.checkout-field
     input/select`) só que combobox custom em vez de <select> nativo. */
  .ck-select {
    position: relative;
  }
  .ck-select__btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-md, 8px);
    padding: 10px 12px;
    color: #fff;
    font-size: 14px;
    font-family: inherit;
    cursor: pointer;
    transition: border-color var(--ease);
  }
  .ck-select__btn:focus-visible,
  .ck-select__btn[aria-expanded="true"] {
    outline: none;
    border-color: var(--c-accent);
  }
  .ck-select__btn svg {
    flex-shrink: 0;
    color: #999;
    transition: transform 0.15s ease;
  }
  .ck-select__btn[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }
  .ck-select__list {
    position: fixed;
    z-index: 50;
    top: 0;
    left: 0;
    margin: 0;
    padding: 4px;
    list-style: none;
    background: #1c1c1c;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-md, 8px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    max-height: 220px;
    overflow-y: auto;
  }
  .ck-select__list[hidden] {
    display: none !important;
  }
  .ck-select__list [role="option"] {
    padding: 9px 10px;
    border-radius: 6px;
    font-size: 14px;
    color: #ddd;
    cursor: pointer;
  }
  .ck-select__list [role="option"]:hover,
  .ck-select__list [role="option"].is-active {
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
  }
  .ck-select__list [role="option"].is-selected {
    color: var(--c-accent);
    font-weight: 700;
  }
  .checkout-secure-field {
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-md, 8px);
    padding: 4px 12px;
    height: 40px;
  }
  .checkout-error {
    color: #fca5a5;
    font-size: 13px;
    margin: 12px 0 0;
  }
  .checkout-login-needed {
    margin-top: 16px;
    padding: 14px 16px;
    background: rgba(231, 126, 35, 0.08);
    border: 1px solid rgba(231, 126, 35, 0.3);
    border-radius: var(--r-md, 8px);
  }
  .checkout-login-needed p {
    font-size: 13px;
    color: #f0c896;
    margin: 0 0 10px;
  }
  .checkout-login-needed .checkout-field {
    max-width: 260px;
  }
  .checkout-link-btn {
    margin-top: 10px;
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--c-accent);
    font-size: 12px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .checkout-link-btn:hover {
    color: #fff;
  }
  .checkout-hint {
    margin: 8px 0 0;
    font-size: 12px;
    color: #b8b8b8;
  }

  /* ── Endereço travado (esquerda, depois de confirmado): overlay por cima
       do formulário preenchido — continua visível, só fica desabilitado. ── */
  .checkout-step-wrap {
    position: relative;
    max-width: 560px;
  }
  .checkout-step-wrap.is-locked .checkout-step {
    filter: blur(1.5px);
    opacity: 0.45;
    pointer-events: none;
    user-select: none;
  }
  .checkout-address-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(15, 15, 15, 0.42);
    backdrop-filter: blur(2px);
    border-radius: var(--r-lg, 12px);
    z-index: 2;
  }
  /* `display:flex` acima é regra de autor e ganha do `[hidden]` da UA
     stylesheet — sem essa guarda o overlay fica sempre visível mesmo com o
     atributo `hidden` setado depois do clique em "Editar" (o handler já
     tava certo, só o CSS que nunca escondia de fato). */
  .checkout-address-overlay[hidden] {
    display: none !important;
  }
  .checkout-address-overlay__card {
    width: 100%;
    max-width: 380px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 10px;
    padding: 24px 22px;
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-lg, 12px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
  }
  .checkout-address-overlay__lock {
    color: var(--c-accent);
  }
  .checkout-address-overlay__name {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .checkout-address-overlay__lines {
    font-size: 13px;
    color: #b8b8b8;
    margin: 0;
    line-height: 1.5;
  }
  .checkout-address-overlay__edit {
    margin-top: 6px;
    background: none;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--r-md, 8px);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 8px 18px;
    cursor: pointer;
  }
  .checkout-address-overlay__edit:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }

  /* ── Cliente logado: cartão-resumo (passo 1) / cards de endereço (passo 2)
       no lugar do form cru — mesmo visual do card de endereço travado acima. ── */
  .checkout-account-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 18px;
    margin-bottom: 20px;
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-lg, 12px);
  }
  .checkout-account-card[hidden] {
    display: none !important;
  }
  .checkout-account-card--addresses {
    flex-direction: column;
    align-items: stretch;
  }
  .checkout-account-card__info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .checkout-account-card__name {
    font-size: 14px;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }
  .checkout-account-card__detail {
    font-size: 13px;
    color: #b8b8b8;
    margin: 0;
  }
  :global(.checkout-address-card)s {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }
  :global(.checkout-address-card) {
    position: relative;
    display: block;
    width: 100%;
    color: #fff;
    font-family: inherit;
    text-align: left;
    padding: 14px 16px;
    background: #1c1c1c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-md, 8px);
    cursor: pointer;
    transition: border-color var(--ease);
  }
  :global(.checkout-address-card):hover {
    border-color: rgba(255, 255, 255, 0.32);
  }
  :global(.checkout-address-card).is-selected {
    border-color: var(--c-accent);
    background: rgba(231, 126, 35, 0.08);
  }
  :global(.checkout-address-card__badge) {
    position: absolute;
    top: 12px;
    right: 14px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-accent);
    background: rgba(231, 126, 35, 0.14);
    padding: 3px 8px;
    border-radius: 999px;
  }
  :global(.checkout-address-card__name),
  :global(.checkout-address-card__lines) {
    text-align: left;
  }
  :global(.checkout-address-card__name) {
    font-size: 13px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 4px;
  }
  :global(.checkout-address-card__lines) {
    font-size: 12px;
    color: #b8b8b8;
    margin: 0;
    line-height: 1.5;
  }

  .checkout-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 20px;
  }
  .checkout-tab {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    border-radius: var(--r-md, 8px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: transparent;
    color: #b8b8b8;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
  }
  .checkout-tab svg {
    flex-shrink: 0;
  }
  .checkout-tab.is-active {
    border-color: var(--c-accent);
    color: var(--c-accent);
  }
  .checkout-hint {
    color: #b8b8b8;
    font-size: 13px;
    line-height: 1.5;
    margin: 0 0 16px;
  }
  .checkout-pix-qr {
    display: block;
    width: 180px;
    height: 180px;
    margin: 0 auto 16px;
    border-radius: var(--r-md, 8px);
    background: #fff;
  }
  .checkout-pix-code {
    width: 100%;
    background: #171717;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: var(--r-md, 8px);
    color: #fff;
    font-size: 12px;
    padding: 10px;
    margin-bottom: 12px;
    resize: none;
  }
  .checkout-waiting {
    color: #b8b8b8;
    font-size: 13px;
    margin-top: 14px;
  }
  :global(.pac-container) {
    background: #1c1c1c;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    font-family: inherit;
    z-index: 300;
  }
  :global(.pac-item) {
    color: #bbb;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 10px;
  }
  :global(.pac-item:hover), :global(.pac-item-selected) {
    background: rgba(255, 255, 255, 0.06);
  }
  :global(.pac-item-query) {
    color: #fff;
  }
  .checkout-pix-timer {
    margin: 0 0 10px;
    font-size: 13px;
    color: #bbb;
  }
  .checkout-pix-timer strong {
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .checkout-pix-timer.is-low strong {
    color: #f87171;
  }
  .checkout-pix-expired {
    text-align: center;
    padding: 16px 0;
  }
  .checkout-pix-expired p {
    margin: 0 0 12px;
    color: #f0f0f0;
  }
  .checkout-pix-expired[hidden] {
    display: none;
  }
  .checkout-link-btn--danger {
    color: #f87171;
  }
  .checkout-address-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 4px 0 16px;
  }
  .checkout-address-actions[hidden] {
    display: none;
  }
  .checkout-address-actions .checkout-error {
    flex-basis: 100%;
    margin: 0;
  }
  /* Endereço (largo) e Número lado a lado, ocupando a linha toda do grid. */
  .checkout-address-row {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 110px;
    gap: 12px;
  }
  #ck-email[readonly] {
    opacity: 0.7;
    cursor: not-allowed;
  }
  /* `display:flex` do bloco ganha do `[hidden]` da UA: sem isto o "pedido confirmado" aparece junto do formulário. */
  .checkout-success[hidden] {
    display: none;
  }
  /* Aviso central durante preparo e confirmação: bola quicando + barra que corre (CSS puro, sem biblioteca). */
  .checkout-busy {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: grid;
    place-items: center;
    background: rgba(8, 8, 8, 0.72);
    backdrop-filter: blur(6px);
  }
  .checkout-busy[hidden] {
    display: none;
  }
  .checkout-busy__card {
    width: min(86vw, 360px);
    text-align: center;
    color: #fff;
  }
  .checkout-busy__stage {
    position: relative;
    height: 96px;
    display: grid;
    justify-items: center;
    align-items: end;
  }
  .checkout-busy__ball {
    position: absolute;
    bottom: 12px;
    animation: busy-bounce 0.9s cubic-bezier(0.3, 0, 0.7, 1) infinite;
    transform-origin: 50% 100%;
  }
  .checkout-busy__shadow {
    width: 44px;
    height: 6px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    animation: busy-shadow 0.9s cubic-bezier(0.3, 0, 0.7, 1) infinite;
  }
  .checkout-busy__bar {
    position: relative;
    height: 6px;
    margin: 18px 0 16px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    overflow: hidden;
  }
  .checkout-busy__bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 38%;
    border-radius: inherit;
    background: linear-gradient(90deg, rgba(231, 126, 35, 0), #e77e23 40%, #ffb066);
    animation: busy-run 1.3s ease-in-out infinite;
  }
  .checkout-busy__text {
    margin: 0 0 6px;
    min-height: 22px;
    font-family: var(--font-title);
    font-size: 20px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .checkout-busy__hint {
    margin: 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.55);
  }
  @keyframes busy-bounce {
    0%, 100% { transform: translateY(0) scale(1.08, 0.9); }
    50% { transform: translateY(-46px) scale(1, 1); }
  }
  @keyframes busy-shadow {
    0%, 100% { transform: scaleX(1); opacity: 0.7; }
    50% { transform: scaleX(0.55); opacity: 0.3; }
  }
  @keyframes busy-run {
    0% { left: -40%; }
    100% { left: 102%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .checkout-busy__ball, .checkout-busy__shadow { animation: none; }
    .checkout-busy__bar span { animation-duration: 2.6s; }
  }
  .checkout-success {
    text-align: center;
    padding: 56px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .checkout-success__anim { position: relative; display: grid; place-items: center; width: 112px; height: 112px; margin-bottom: 20px; color: var(--c-accent, #e77e23); }
  .checkout-success__ring { position: absolute; inset: 0; border: 3px solid currentColor; border-radius: 50%; animation: ck-pop 0.7s ease-out both, ck-pulse 2.4s ease-in-out 0.8s infinite; }
  .checkout-success__check { stroke-dasharray: 30; stroke-dashoffset: 30; animation: ck-draw 0.6s ease-out 0.4s forwards; }
  .checkout-success .checkout-success__order { font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-accent, #e77e23); margin: 0 0 8px; }
  .checkout-success__items { list-style: none; margin: 0 0 8px; padding: 0; width: 100%; max-width: 440px; text-align: left; }
  .checkout-success__items :global(li) { display: flex; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.1); color: #fff; font-size: 14px; }
  .checkout-success__items :global(small) { display: block; color: #9a9a9a; }
  .checkout-success .checkout-success__total { color: #fff; font-weight: 800; font-size: 18px; margin: 4px 0 16px; }
  .checkout-success .checkout-success__mail { font-size: 14px; }
  .checkout-success .checkout-success__spam { font-size: 13px; max-width: 440px; color: #b8b8b8; margin: 0 0 20px; }
  .checkout-success__actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin: 8px 0 24px; }
  .checkout-success__social { list-style: none; margin: 0; padding: 0; display: flex; gap: 20px; flex-wrap: wrap; justify-content: center; }
  .checkout-success__social a { color: #fff; font-weight: 700; font-size: 14px; text-decoration: none; }
  .checkout-success__social a:hover { color: var(--c-accent, #e77e23); }
  @keyframes ck-pop { from { transform: scale(0.4); opacity: 0; } to { transform: scale(1); opacity: 1; } }
  @keyframes ck-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(231, 126, 35, 0.45); } 50% { box-shadow: 0 0 0 16px rgba(231, 126, 35, 0); } }
  @keyframes ck-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .checkout-success__ring, .checkout-success__check { animation: none; stroke-dashoffset: 0; } }
  .checkout-success h2 {
    font-family: var(--font-title);
    text-transform: uppercase;
    font-size: 28px;
    margin: 0 0 12px;
    color: #fff;
  }
  .checkout-success p {
    color: #b8b8b8;
    margin: 0 0 24px;
  }

  /* ── Resumo + pagamento: painel travado à direita ── */
  .checkout-summary {
    background: #131313;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    padding: 24px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  /* `display:flex` acima é regra de autor e ganha do `[hidden]` da UA —
     sem essa guarda o painel de resumo/pagamento fica visível mesmo depois
     de completeCart() esconder ele (`panel.hidden = true`). */
  .checkout-summary[hidden] {
    display: none !important;
  }
  .checkout-summary__toggle {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: 0;
    padding: 0 0 16px;
    cursor: pointer;
    color: #fff;
  }
  .checkout-summary__toggle-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-title);
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
