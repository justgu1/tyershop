---
import Layout from '../../layouts/Layout.astro';
import CollectionMosaicItem from '../../components/CollectionMosaicItem.astro';
import { getLangFromUrl, t, getPathForLang } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getMedusaStoreUrl, getPublishableKey } from '../../lib/medusa-env';
import { getProductListQueryString, resolveDefaultRegionId } from '../../lib/medusa-pricing';

export const prerender = false;

const lang: Lang = getLangFromUrl(Astro.url);
const { handle } = Astro.params;
const h = String(handle ?? '').trim();

const pk = getPublishableKey();
const headers = { 'x-publishable-api-key': pk };
const base = getMedusaStoreUrl();

let collection: { id: string; title: string; handle: string; metadata?: Record<string, unknown> } | null = null;
let products: any[] = [];

try {
  const regionId = await resolveDefaultRegionId(base, headers);
  const q = getProductListQueryString(regionId);

  const listRes = await fetch(`${base}/store/collections?limit=100`, {
    headers,
    signal: AbortSignal.timeout(8000),
  });
  if (listRes.ok) {
    const list = ((await listRes.json()).collections ?? []) as any[];
    collection = list.find((c) => String(c?.handle ?? '') === h) ?? null;
  }

  if (collection?.id) {
    const pRes = await fetch(
      `${base}/store/products?${q}&collection_id[]=${encodeURIComponent(collection.id)}&limit=60`,
      { headers, signal: AbortSignal.timeout(8000) }
    );
    if (pRes.ok) {
      const d = await pRes.json();
      products = d.products ?? [];
    }
  }
} catch {
  /* Medusa indisponível */
}

const found = !!collection;
if (!found && h) {
  Astro.response.status = 404;
}

const colTitle = collection?.title ?? h;
const metaDesc =
  typeof collection?.metadata?.description === 'string' && String(collection.metadata.description).trim()
    ? String(collection.metadata.description).trim()
    : t(lang, 'collections', 'meta_description').replace('{title}', colTitle);
---

<Layout
  title={found ? `${colTitle} — Tyer` : t(lang, 'collections', 'not_found_title')}
  description={found ? metaDesc : t(lang, 'collections', 'not_found_desc')}
  lang={lang}
  ogImage={found ? `/collections/${collection!.handle}.webp` : '/logo.webp'}
  noindex={!found}
>
  {
    found ? (
      <main class="collection-page">
        <section class="collection-banner">
          <img
            src={`/collections/${collection!.handle}.webp`}
            alt=""
            class="collection-banner__img"
            onerror="this.style.display='none'"
          />
          <div class="collection-banner__overlay" aria-hidden="true" />
          <div class="collection-banner__content container">
            <nav class="collection-breadcrumb" aria-label="Breadcrumb">
              <ol class="collection-breadcrumb__list">
                <li>
                  <a href={getPathForLang('/', lang)}>{t(lang, 'collections', 'breadcrumb_home')}</a>
                </li>
                <li aria-hidden="true">/</li>
                <li>
                  <a href={`${getPathForLang('/', lang)}#collection`}>{t(lang, 'nav', 'collections')}</a>
                </li>
                <li aria-hidden="true">/</li>
                <li aria-current="page">{colTitle}</li>
              </ol>
            </nav>
            <p class="collection-banner__eyebrow">{t(lang, 'drops', 'the_collection')}</p>
            <h1 class="collection-banner__title">{colTitle}</h1>
            {metaDesc && <p class="collection-banner__desc">{metaDesc}</p>}
            <p class="collection-banner__count">
              {products.length}{' '}
              {products.length === 1 ? t(lang, 'collections', 'piece_one') : t(lang, 'collections', 'pieces')}
            </p>
          </div>
        </section>

        <div class="container">
          {products.length > 0 ? (
            <div class="collection-mosaic" role="list" aria-label={colTitle}>
              {products.map((p, i) => (
                <CollectionMosaicItem product={p} lang={lang} reverse={i % 2 === 1} />
              ))}
            </div>
          ) : (
            <p class="collection-empty">{t(lang, 'collections', 'empty')}</p>
          )}

          <p class="collection-footer">
            <a href={getPathForLang('/shop', lang)} class="btn btn-outline">
              {t(lang, 'collections', 'back_shop')}
            </a>
          </p>
        </div>
      </main>
    ) : (
      <div class="collection-nf container">
        <p class="collection-nf__code">404</p>
        <h1 class="collection-nf__title">{t(lang, 'collections', 'not_found_title')}</h1>
        <p class="collection-nf__sub">{t(lang, 'collections', 'not_found_desc')}</p>
        <div class="collection-nf__actions">
          <a class="btn btn-primary" href={getPathForLang('/', lang)}>
            {t(lang, 'pdp', 'product_not_found_home')}
          </a>
          <a class="btn btn-outline" href={getPathForLang('/shop', lang)}>
            {t(lang, 'pdp', 'product_not_found_shop')}
          </a>
        </div>
      </div>
    )
  }
</Layout>

<style>
  .collection-page {
    padding-bottom: 64px;
  }
  .container {
    max-width: var(--max-w, 1200px);
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
  }

  /* ── Banner ── */
  .collection-banner {
    position: relative;
    min-height: min(56vh, 520px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    margin-bottom: 48px;
  }
  .collection-banner__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
  }
  .collection-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.35) 55%, rgba(0, 0, 0, 0.15) 100%);
  }
  .collection-banner__content {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--header-h) + 24px);
    padding-bottom: 40px;
    color: #fff;
  }
  .collection-breadcrumb {
    margin-bottom: 20px;
  }
  .collection-breadcrumb__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.65);
  }
  .collection-breadcrumb a {
    color: rgba(255, 255, 255, 0.65);
    text-decoration: none;
  }
  .collection-breadcrumb a:hover {
    color: var(--c-accent);
  }
  .collection-banner__eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-accent);
    margin: 0 0 8px;
  }
  .collection-banner__title {
    font-family: var(--font-title);
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase;
    line-height: 0.95;
    margin: 0 0 14px;
    max-width: 16ch;
  }
  .collection-banner__desc {
    max-width: 56ch;
    font-size: 15px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.82);
    margin: 0 0 12px;
  }
  .collection-banner__count {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ── Mosaico: cada item é um bloco próprio (ver CollectionMosaicItem.astro) ── */
  .collection-mosaic {
    display: flex;
    flex-direction: column;
  }
  .collection-empty {
    font-size: 15px;
    color: var(--c-muted);
    margin: 0 0 32px;
  }
  .collection-footer {
    display: flex;
    justify-content: center;
  }
  .collection-nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 48px 20px;
  }
  .collection-nf__code {
    font-family: var(--font-title);
    font-size: clamp(64px, 12vw, 120px);
    color: var(--c-accent);
    margin: 0;
    line-height: 1;
  }
  .collection-nf__title {
    font-family: var(--font-title);
    font-size: clamp(22px, 4vw, 40px);
    text-transform: uppercase;
    margin: 0;
  }
  .collection-nf__sub {
    max-width: 420px;
    color: var(--c-muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }
  .collection-nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 16px;
  }
</style>
