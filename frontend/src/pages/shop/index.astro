---
import Layout from '../../layouts/Layout.astro';
import ProductGalleryRow from '../../components/ProductGalleryRow.astro';
import { getLangFromUrl, getPathForLang, t } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { fetchCatalogSections } from '../../lib/catalog-sections';

// Catálogo dinâmico: renderiza por requisição (ver index.astro).
export const prerender = false;

const lang: Lang = getLangFromUrl(Astro.url);
const showEmptyCheckoutToast = Astro.url.searchParams.get('empty_checkout') === '1';
const sections = await fetchCatalogSections();
---

<Layout
  title={t(lang, 'nav', 'shop')}
  description={t(lang, 'shop', 'meta_description')}
  lang={lang}
  bodyClass="page-shop"
>
  {showEmptyCheckoutToast && (
    <div class="shop-toast" id="shop-empty-toast" role="status" aria-live="polite">
      <span>Adicione produtos para ir para o checkout.</span>
      <button type="button" class="shop-toast__close" id="shop-empty-toast-close" aria-label="Fechar aviso">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <script is:inline>
      (function () {
        var toast = document.getElementById('shop-empty-toast');
        if (!toast) return;
        // Tira o ?empty_checkout=1 da URL — não deve voltar a aparecer num refresh.
        try {
          var url = new URL(window.location.href);
          url.searchParams.delete('empty_checkout');
          window.history.replaceState({}, '', url.pathname + url.search + url.hash);
        } catch (e) {}
        var dismiss = function () { toast.remove(); };
        document.getElementById('shop-empty-toast-close')?.addEventListener('click', dismiss);
        window.setTimeout(dismiss, 6000);
      })();
    </script>
  )}

  <div class="shop-layout" id="shop-top">
    <div
      class="shop-sidebar-backdrop"
      id="shop-sidebar-backdrop"
      hidden
      aria-hidden="true"
    />
    <aside class="shop-sidebar" id="shop-sidebar" aria-label={t(lang, 'shop', 'filters')}>
      <div class="shop-sidebar__sticky">
      <div class="shop-sidebar__inner">
        <h2 class="shop-sidebar__title">{t(lang, 'shop', 'filters')}</h2>

        <nav class="shop-toc" aria-label="Seções da loja">
          <p class="shop-toc__label" id="toc-nav-label">Navegação</p>
          <ul class="shop-toc__list" role="list" aria-labelledby="toc-nav-label">
            {sections.map((sec) => (
              <li>
                <button type="button" class="shop-toc__btn" data-scroll-target={`shop-${sec.key}`}>{sec.title}</button>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      </div>
    </aside>

    <main class="shop-main" id="shop-main">
      <div class="shop-mobile-bar">
        <button type="button" class="shop-header__filter-toggle btn btn-outline" id="filter-toggle">
          {t(lang, 'shop', 'filters')}
        </button>
      </div>

      {sections.map((sec) => (
        <section class="shop-block" id={`shop-${sec.key}`} aria-labelledby={`shop-${sec.key}-title`}>
          <div class="shop-block__head">
            <h2 class="shop-block__title" id={`shop-${sec.key}-title`}>{sec.title}</h2>
            {sec.href && <a href={getPathForLang(sec.href, lang)} class="shop-col__drop-link btn btn-outline btn-sm">Ver tudo</a>}
          </div>
          <div class="shop-rows">
            {sec.products.map((p) => <ProductGalleryRow product={p} lang={lang} />)}
          </div>
        </section>
      ))}
    </main>
  </div>
</Layout>

<style is:global>
  .shop-block__head { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  /* Celular: um produto por linha; no desktop entram quantos couberem (3, 2...). */
  .shop-rows { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 32px 24px; align-items: start; }
  .shop-rows > article.prow { max-width: none; }
  /** Tema claro só dentro da loja — não alterar :root (header, mega, footer mantêm o escuro). */
  body.page-shop {
    background: #f8f8f8;
    --tile-fg: #0a0a0a;
  }
  body.page-shop main {
    background: #f8f8f8;
    /* `overflow-x: hidden` no main quebra `position: sticky` na sidebar (filho do mesmo grid). */
    overflow-x: visible;
    overflow-y: visible;
  }
  /* Sticky falha com `overflow-x: hidden` em html/body — na loja relaxamos só o eixo horizontal. */
  html:has(body.page-shop) {
    overflow-x: visible;
    max-width: 100%;
  }
  body.page-shop {
    overflow-x: visible;
  }
  body.page-shop .shop-layout {
    max-width: 100%;
    min-width: 0;
    --c-bg: #f8f8f8;
    --c-surface: #ffffff;
    --c-surface2: #f0f0f0;
    --c-border: #e8e8e8;
    --c-text: #0a0a0a;
    --c-muted: #5c5c5c;
    --c-bg-mute: #ececec;
    --pc-price-current: #0a0a0a;
    --pc-price-striked: rgba(10, 10, 10, 0.45);
    --pc-name-color: #0a0a0a;
    --pc-muted-text: rgba(10, 10, 10, 0.55);
    --pc-muted-text-strong: rgba(10, 10, 10, 0.72);
    --pc-divider: rgba(10, 10, 10, 0.1);
    --pc-ok-text: #16a34a;
    --pc-err-text: #dc2626;
  }
  body.page-shop .shop-main {
    background: var(--c-bg);
  }
  body.page-shop .shop-block__title {
    color: #0a0a0a;
  }
  body.page-shop .shop-layout .pc__quick-add img {
    filter: brightness(0) invert(1);
    opacity: 1;
  }
  body.page-shop .shop-sidebar {
    background: #141414;
    border-right-color: #2a2a2a;
  }
  body.page-shop .shop-sidebar__title {
    color: #f5f5f5;
  }
  body.page-shop .shop-toc__label {
    color: rgba(255, 255, 255, 0.45);
  }
  body.page-shop .shop-toc__btn {
    color: rgba(255, 255, 255, 0.72);
  }
  body.page-shop .shop-toc__btn:hover,
  body.page-shop .shop-toc__btn:focus-visible {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }
  body.page-shop .shop-toc__btn.is-active {
    color: #fff;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 2px 0 0 var(--c-accent);
  }
  body.page-shop .shop-sidebar .shop-header__count {
    color: rgba(255, 255, 255, 0.55);
  }
  body.page-shop .btn-outline {
    color: var(--c-text);
    border-color: #c8c8c8;
  }
  body.page-shop .btn-outline:hover {
    background: var(--c-surface2);
    border-color: #b0b0b0;
  }
  /* .shop-col-carousel* removido — <ProductCarousel> usa var(--c-border)/
     var(--c-text), que já assumem os valores de tema claro definidos logo
     acima (body.page-shop), sem precisar de override específico daqui. */
  body.page-shop .pc__variants-divider {
    border-top-color: rgba(0, 0, 0, 0.08);
  }
  body.page-shop .pc__variant-heading {
    color: rgba(0, 0, 0, 0.5);
  }
  body.page-shop .pc__variant-heading-k {
    color: rgba(0, 0, 0, 0.62);
  }
  body.page-shop .pc__variant-hit--swatch {
    border-color: rgba(0, 0, 0, 0.22);
  }
  body.page-shop .pc__variant-hit--size {
    border-color: rgba(0, 0, 0, 0.2);
    color: var(--c-text);
  }
  body.page-shop .pc__variant-hit--size:hover:not(.is-unavailable) {
    border-color: rgba(0, 0, 0, 0.38);
  }
</style>

<style>
.shop-toast {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  padding: 12px 20px;
  background: #171717;
  color: #fff;
  font-size: 13px;
  font-weight: 600;
  text-align: center;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.shop-toast__close {
  flex: 0 0 auto;
  display: inline-flex;
  background: none;
  border: 0;
  color: #b8b8b8;
  cursor: pointer;
  padding: 2px;
}
.shop-toast__close:hover {
  color: #fff;
}

.shop-layout {
  display: grid;
  grid-template-columns: 240px 1fr;
  min-height: calc(100svh - var(--header-h));
  align-items: stretch;
  width: 100%;
  max-width: 100%;
  overflow-x: visible;
}
@media (max-width: 900px) {
  .shop-layout { grid-template-columns: 1fr; }
}

.shop-sidebar {
  position: relative;
  align-self: stretch;
  min-height: 0;
  border-right: 1px solid var(--c-border);
  padding: 0;
  background: var(--c-surface);
}
.shop-sidebar__sticky {
  display: flex;
  flex-direction: column;
  min-height: 0;
}
@media (min-width: 901px) {
  .shop-sidebar__sticky {
    position: sticky;
    top: var(--header-h);
    max-height: calc(100svh - var(--header-h));
    overflow-x: hidden;
    overflow-y: auto;
    padding: 32px 24px;
    box-sizing: border-box;
  }
}
@media (max-width: 900px) {
  .shop-sidebar-backdrop {
    position: fixed; inset: 0; z-index: 460;
    background: rgba(0, 0, 0, 0.55);
    border: 0; padding: 0; margin: 0; cursor: pointer;
  }
  .shop-sidebar-backdrop[hidden] { display: none !important; }
  .shop-sidebar {
    position: fixed; top: 0; left: 0; bottom: 0; z-index: 470;
    width: 280px; transform: translateX(-100%);
    transition: transform 0.3s ease;
    height: 100dvh;
    border-right: none;
  }
  .shop-sidebar.is-open { transform: translateX(0); }
  .shop-sidebar__sticky {
    height: 100%;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 32px 24px;
    box-sizing: border-box;
  }
}
.shop-sidebar__title { font-family: var(--font-title); font-size: 22px; text-transform: uppercase; margin-bottom: 20px; }
.shop-sidebar__inner { min-height: 100%; display: flex; flex-direction: column; }

.shop-toc__label {
  font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-muted); margin-bottom: 10px;
}
.shop-toc__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
.shop-toc__btn {
  text-align: left; padding: 8px 12px; font-size: 13px; color: var(--c-muted); border-radius: var(--r); width: 100%;
  transition: color var(--ease), background var(--ease); background: transparent; border: none; cursor: pointer; font: inherit;
}
.shop-toc__btn:hover, .shop-toc__btn:focus-visible {
  color: var(--c-text); background: var(--c-surface2); outline: none;
}
.shop-toc__btn.is-active {
  color: var(--c-text);
  background: var(--c-surface2);
  box-shadow: inset 2px 0 0 var(--c-accent);
}

.shop-main {
  padding: 32px;
  min-width: 0;
  width: 100%;
  max-width: 100%;
  overflow-x: clip;
}
@media (max-width: 900px) { .shop-main { padding: 24px 16px; } }

.shop-mobile-bar {
  display: none; margin-bottom: 20px;
}
@media (max-width: 900px) {
  /* Sem sticky, o botão só existe uma vez no topo de .shop-main e some
     assim que rola pra baixo — obriga voltar ao topo pra abrir os
     filtros. Mesma propriedade (`top: var(--header-h)`) que a sidebar de
     desktop já usa pra grudar sob o header, unificando o critério em vez
     de cada parte da página inventar seu próprio sticky. */
  .shop-mobile-bar {
    display: flex;
    align-items: center;
    position: sticky;
    top: var(--header-h);
    z-index: 30;
    background: #f8f8f8;
    padding-block: 12px;
    margin-bottom: 8px;
  }
}
.shop-col__head {
  display: flex; align-items: center; justify-content: space-between; gap: 16px;
  margin-bottom: 16px;
}
.shop-block__title--row { margin-bottom: 0; flex: 1; min-width: 0; }
.shop-col__drop-link { flex-shrink: 0; white-space: nowrap; margin-left: auto; }
.shop-header { display: flex; align-items: center; gap: 16px; margin-bottom: 32px; flex-wrap: wrap; }
.shop-header__title { font-family: var(--font-title); font-size: 48px; text-transform: uppercase; flex: 1; }
.shop-header__filter-toggle { display: none; }
@media (max-width: 900px) { .shop-header__filter-toggle { display: inline-flex; } }
.shop-header__count { font-size: 12px; color: var(--c-muted); }
.shop-sidebar .shop-header__count { margin-top: auto; padding-top: 18px; display: block; }

.shop-block {
  margin-bottom: 48px;
  scroll-margin-top: calc(var(--header-h) + 16px);
  min-width: 0;
  max-width: 100%;
}
.shop-block__title {
  font-family: var(--font-title); font-size: clamp(22px, 3vw, 32px); text-transform: uppercase; margin: 0; letter-spacing: 0.02em;
}
.shop-block__empty { color: var(--c-muted); font-size: 14px; }
.shop-block--infinite { margin-bottom: 24px; }

.shop-sentinel { height: 1px; }

.shop-loading {
  display: flex; align-items: center; justify-content: center; gap: 12px;
  padding: 40px; color: var(--c-muted); font-size: 13px;
}
.shop-loading[hidden] { display: none !important; }
.shop-loading__spinner {
  width: 18px; height: 18px; border: 2px solid var(--c-border);
  border-top-color: var(--c-accent); border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.shop-end { text-align: center; padding: 40px; color: var(--c-muted); font-size: 13px; }
@media (max-width: 900px) {
  .shop-col__head { align-items: flex-start; flex-wrap: wrap; gap: 10px; }
  .shop-block__title--row { width: 100%; }
  .shop-col__drop-link { margin-left: 0; }
}
</style>

<!-- Estilos para cards inseridos via JS (escopo do ProductCard não aplica) -->
<style is:global>
#shop-infinite-grid .pc {
  display: flex;
  flex-direction: column;
  position: relative;
  /* height:auto (não 100%) — align-items:stretch do grid só estica um
     item com height especificado como auto; mesma correção aplicada em
     ProductCard.astro. */
  height: auto;
  min-height: 100%;
  transition: transform 0.3s ease;
}
#shop-infinite-grid .pc:hover { transform: translateY(-4px); }
#shop-infinite-grid .pc__link { display: block; }
#shop-infinite-grid .pc__img-wrap {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--c-bg-mute, #1a1a1a);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 8px;
  margin-bottom: 12px;
}
#shop-infinite-grid .pc__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
#shop-infinite-grid .pc:hover .pc__img { transform: scale(1.06); }
#shop-infinite-grid .pc__img--secondary {
  position: absolute;
  inset: 0;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.35s ease, transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
#shop-infinite-grid .pc__img-wrap.is-hover-ready:hover .pc__img--secondary { opacity: 1; }
#shop-infinite-grid .pc__img-wrap.is-hover-ready:hover .pc__img--primary { opacity: 0; }
#shop-infinite-grid .pc__img--primary.is-swapping { opacity: 0; }
#shop-infinite-grid .pc__gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 0;
  background: rgba(10, 10, 10, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.15s ease, background 0.15s ease;
}
#shop-infinite-grid .pc__img-wrap:hover .pc__gallery-arrow { opacity: 1; }
#shop-infinite-grid .pc__gallery-arrow:hover { background: rgba(10, 10, 10, 0.85); }
#shop-infinite-grid .pc__gallery-arrow--prev { left: 8px; }
#shop-infinite-grid .pc__gallery-arrow--next { right: 8px; }
#shop-infinite-grid .pc__gallery-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
#shop-infinite-grid .pc__gallery-dots span {
  width: 12px;
  height: 2.5px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
  transition: background 0.15s ease, width 0.15s ease;
}
#shop-infinite-grid .pc__gallery-dots span.is-active {
  background: var(--c-accent);
  width: 18px;
}
#shop-infinite-grid .pc__tags { position: absolute; left: 8px; display: flex; flex-direction: column; gap: 4px; }
#shop-infinite-grid .pc__tags--priority { top: 8px; }
#shop-infinite-grid .pc__tags--category { top: 8px; left: auto; right: 8px; align-items: flex-end; }
#shop-infinite-grid .pc__tag {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: var(--r);
  color: #fff;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
#shop-infinite-grid .pc__tag--soldout { background: #000; }
#shop-infinite-grid .pc__tag--discount { background: #16a34a; }
#shop-infinite-grid .pc__tag--exclusive { background: #6d28d9; }
#shop-infinite-grid .pc__tag--popular { background: #db2777; }
#shop-infinite-grid .pc__tag--new { background: var(--c-accent); color: #fff; }
#shop-infinite-grid .pc__body {
  text-align: left;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}
#shop-infinite-grid .pc__body-link { text-decoration: none; display: block; }
#shop-infinite-grid .pc__name {
  font-size: 14px;
  font-weight: 500;
  line-height: 1.3;
  color: var(--pc-name-color, var(--c-text));
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.6em;
}
#shop-infinite-grid .pc__bottom {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  margin-top: auto;
  padding-bottom: 8px;
}
#shop-infinite-grid .pc__price-box {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  flex-wrap: wrap;
}
#shop-infinite-grid .pc__price-striked {
  font-size: 12px;
  text-decoration: line-through;
  color: var(--pc-price-striked, rgba(255, 255, 255, 0.58));
  line-height: 1;
}
#shop-infinite-grid .pc__price-current {
  font-size: 16px;
  font-weight: 800;
  color: var(--pc-price-current, #fff);
  line-height: 1;
}
#shop-infinite-grid .pc__price-box--discount .pc__price-current { color: var(--c-accent); }
#shop-infinite-grid .pc__quick-add {
  position: static;
  transform: none;
  width: 100%;
  background: var(--c-accent);
  border: 1px solid var(--c-accent);
  border-radius: var(--r-md, 8px);
  padding: 10px 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
  flex-shrink: 0;
}
#shop-infinite-grid .pc__quick-add img {
  filter: brightness(0) invert(1);
  opacity: 1;
}
#shop-infinite-grid .pc__quick-add__label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #fff;
  white-space: nowrap;
}
#shop-infinite-grid .pc__quick-add:hover {
  background: var(--c-accent-d);
  border-color: var(--c-accent-d);
}
#shop-infinite-grid .pc__quick-add:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  border-color: rgba(248, 113, 113, 0.45);
}
#shop-infinite-grid .pc__quick-add:disabled:hover {
  background: #991b1b;
  border-color: #ef4444;
}
#shop-infinite-grid .pc__bottom--oos .pc__price-box,
#shop-infinite-grid .pc__bottom--oos .pc__quick-add {
  display: none;
}
#shop-infinite-grid .pc__stock-notify {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
#shop-infinite-grid .pc__stock-notify__intro {
  margin: 0 0 8px;
  font-size: 12px;
  line-height: 1.35;
  color: rgba(255, 255, 255, 0.72);
}
#shop-infinite-grid .pc__stock-notify__row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: stretch;
}
#shop-infinite-grid .pc__stock-notify__input {
  flex: 1 1 140px;
  min-width: 0;
  padding: 8px 10px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: rgba(0, 0, 0, 0.25);
  color: #fff;
  font-size: 13px;
}
#shop-infinite-grid .pc__stock-notify__btn {
  flex: 0 0 auto;
  padding: 8px 12px;
  font-size: 12px;
  font-weight: 700;
}
#shop-infinite-grid .pc__stock-notify__feedback {
  margin: 8px 0 0;
  font-size: 12px;
}
#shop-infinite-grid .pc__stock-notify__feedback.is-ok {
  color: #7dffb2;
}
#shop-infinite-grid .pc__stock-notify__feedback.is-err {
  color: #ff8a8a;
}
#shop-infinite-grid .pc__variants {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 10px;
  margin-bottom: 10px;
}
#shop-infinite-grid .pc__variants-divider {
  height: 0;
  border: 0;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  margin: 2px 0 4px;
