  body.shop-sidebar-open #nav-collections-wrap { pointer-events: none; }
  body.shop-sidebar-open .mega { display: none !important; opacity: 0 !important; visibility: hidden !important; }
</style>

<script>
  const sidebar = document.getElementById('shop-sidebar');
  const backdrop = document.getElementById('shop-sidebar-backdrop');
  function setSidebarOpen(open: boolean) {
    document.body.classList.toggle('shop-sidebar-open', open);
    sidebar?.classList.toggle('is-open', open);
    if (backdrop) backdrop.hidden = !open;
  }

  document.querySelectorAll<HTMLElement>('[data-scroll-target]').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.shop-toc__btn').forEach((item) => item.classList.remove('is-active'));
      btn.classList.add('is-active');
      document.getElementById(btn.dataset.scrollTarget || '')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      setSidebarOpen(false);
    });
  });

  const buttons = Array.from(document.querySelectorAll<HTMLElement>('.shop-toc__btn'));
  const blocks = Array.from(document.querySelectorAll<HTMLElement>('.shop-block'));
  if (buttons.length && blocks.length && 'IntersectionObserver' in window) {
    const byTarget = new Map(buttons.map((b) => [b.dataset.scrollTarget, b]));
    const observer = new IntersectionObserver(
      (entries) => {
        const top = entries.filter((e) => e.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!top?.target.id) return;
        buttons.forEach((b) => b.classList.remove('is-active'));
        byTarget.get(top.target.id)?.classList.add('is-active');
      },
      { rootMargin: '-35% 0px -45% 0px', threshold: [0.1, 0.3, 0.6] }
    );
    blocks.forEach((block) => observer.observe(block));
  }

  document.getElementById('filter-toggle')?.addEventListener('click', (e) => {
    e.stopPropagation();
    setSidebarOpen(!sidebar?.classList.contains('is-open'));
  });
  backdrop?.addEventListener('click', () => setSidebarOpen(false));
</script>
