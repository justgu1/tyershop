---
import Layout from '../layouts/Layout.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import { t, getPathForLang, type Lang } from '../i18n/utils';
import Countdown from '../components/drop/Countdown.astro';
import { getMedusaStoreUrl, getPublishableKey } from '../lib/medusa-env';
import { fetchDrops, fetchProductsByIds, fetchStarterProducts, dropCountdown, PHASE_LABEL } from '../lib/drop';
import { fetchCollectionsWithCounts } from '../lib/collections';
import { cached } from '../lib/ssr-cache';

const HISTORY_VIDEO_URL = 'https://www.youtube.com/watch?v=zGpL52lmYp4';

// Home busca catálogo no Medusa: precisa renderizar por requisição —
// pré-renderizada o HTML congelaria com o estado do build (sem backend).
export const prerender = false;

const lang: Lang = 'pt';
const pk = getPublishableKey();
const publicApiUrl = (import.meta.env.PUBLIC_API_URL || 'http://localhost:3000').replace(/\/$/, '');

let siteConfig: any = null;

try {
  siteConfig = await cached('site-config', 60_000, async () => {
    const scRes = await fetch(`${getMedusaStoreUrl()}/store/site-config`, {
      headers: { 'x-publishable-api-key': pk },
      signal: AbortSignal.timeout(5000),
    });
    if (!scRes.ok) throw new Error('site-config');
    return (await scRes.json()).site_config ?? null;
  });
} catch {}

const [{ drop, product_ids }, collections] = await Promise.all([
  fetchDrops(),
  fetchCollectionsWithCounts(),
]);
const getCollectionImage = (col: { handle: string }) => `/collections/${col.handle || 'no-data'}.webp`;
const getCount = (col: { products_count?: number }) => col.products_count ?? 0;

const heroVideoUrl = drop && drop.hero_kind !== 'banner' ? drop.hero_url : null;
const heroBannerUrl = drop && drop.hero_kind === 'banner' ? drop.hero_url : null;
const dropCd = drop ? dropCountdown(drop) : null;

// Em venda geral o drop sai do hero e vira vitrine: produtos acima do carousel de drops e um card dentro dele.
const generalDrop = drop?.phase === 'general' ? drop : null;
const dropProducts = generalDrop ? await fetchProductsByIds(product_ids) : [];
// Peças que acompanham o drop sem fazer parte dele (vendem o ano todo): entram no mesmo carousel, depois das do drop.
const OUTROS_HANDLES = ['camiseta-tyer-starter-dry-fit', 'pulseira-cacada'];
const inDrop = new Set(dropProducts.map((p: any) => p.id));
const outros = generalDrop && dropProducts.length > 0
  ? (await fetchStarterProducts(OUTROS_HANDLES)).filter((p: any) => !inDrop.has(p.id))
  : [];
const dropCard = generalDrop && dropProducts.length > 0
  ? { handle: generalDrop.handle, title: generalDrop.title, href: '/shop#shop-drop', count: dropProducts.length }
  : null;
const dropCards = [
  ...(dropCard ? [{ ...dropCard, isDrop: true }] : []),
  ...collections.map((c) => ({ handle: c.handle, title: c.title, href: `/collections/${c.handle}`, count: getCount(c), isDrop: false })),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Tyer',
  url: 'https://tyer.com.br',
};

const YOUTUBE_URL = 'https://www.youtube.com/@tyer_br';
const WHATSAPP_GROUP_URL = 'https://chat.whatsapp.com/JI022Gqv3szBEKCcNBMEwN';
---

<Layout
  title="Tyer"
  description="TYER — Streetwear e Basketball. Peças únicas feitas para durar."
  lang={lang}
  ogImage="/logo.webp"
  bodyClass="home"
  jsonLd={jsonLd}
>
  <!-- Config for client-side JS -->
  <div id="app-config" data-pk={pk} hidden aria-hidden="true"></div>

  <!-- HERO -->
  <section class="hero" aria-label="Hero">
    {heroBannerUrl ? (
      <picture class="hero__picture">
        <img src={heroBannerUrl} alt={drop?.title ?? 'Tyer'} class="hero__image" loading="eager" decoding="async" />
      </picture>
    ) : (
      <>
        <picture class="hero__picture">
          <source srcset="/hero.avif" type="image/avif" />
          <source srcset="/hero.webp" type="image/webp" />
          <source srcset="/hero.jpg" type="image/jpeg" />
          <img src="/hero.jpg" alt="Hero" class="hero__image" loading="eager" decoding="async" />
        </picture>

        <video class="hero__video" muted loop playsinline preload="auto" aria-hidden="true">
          {heroVideoUrl ? (
            <source src={heroVideoUrl} />
          ) : (
            <>
              <source src="/video/hero.webm" type="video/webm" />
              <source src="/video/hero.compressed.mp4" type="video/mp4" />
            </>
          )}
        </video>
      </>
    )}
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="hero__bottom-stack">
      {generalDrop && dropCard && (
        <a class="hero__drop hero__drop--general" href="/shop#shop-drop">
          <h2 class="hero__drop-title">{generalDrop.title}</h2>
          <span class="hero__drop-cta">Ver loja →</span>
        </a>
      )}
      {drop && !(generalDrop && dropCard) && (
        <a class="hero__drop" href="/drop">
          <span class="hero__drop-phase">{PHASE_LABEL[drop.phase]}</span>
          <h2 class="hero__drop-title">{drop.title}</h2>
          {drop.subtitle && <span class="hero__drop-subtitle">{drop.subtitle}</span>}
          {dropCd?.target && <Countdown targetIso={dropCd.target} label={dropCd.label} />}
          <span class="hero__drop-cta">{dropCd?.cta} →</span>
        </a>
      )}
      {!drop && siteConfig?.countdown?.enabled && siteConfig?.countdown?.targetIso && (
        <div class="hero__countdown" id="hero-countdown" data-target-iso={siteConfig.countdown.targetIso}>
          <p class="hero__countdown-label">{siteConfig.countdown.label || 'Próximo Drop em'}</p>
          <div class="hero__countdown-clock" role="timer" aria-live="off">
            <div class="hero__countdown-unit"><span class="hero__countdown-num" data-cd="d">00</span><span class="hero__countdown-u">dias</span></div>
            <div class="hero__countdown-unit"><span class="hero__countdown-num" data-cd="h">00</span><span class="hero__countdown-u">h</span></div>
            <div class="hero__countdown-unit"><span class="hero__countdown-num" data-cd="m">00</span><span class="hero__countdown-u">min</span></div>
            <div class="hero__countdown-unit"><span class="hero__countdown-num" data-cd="s">00</span><span class="hero__countdown-u">s</span></div>
          </div>
          {siteConfig?.countdown?.presaveEnabled && (
            <form class="hero__presave" id="hero-presave-form" novalidate data-api-url={publicApiUrl}>
              <input type="email" name="email" required class="hero__presave-input" placeholder="seu@email.com" aria-label="E-mail" autocomplete="email" />
              <button type="submit" class="hero__presave-btn">{siteConfig.countdown.presaveCta || 'Pre-save o drop'}</button>
            </form>
          )}
          <p class="hero__presave-feedback" id="hero-presave-feedback" hidden></p>
        </div>
      )}
      <a href={dropCards.length > 0 ? '#collection' : '#editorial'} class="hero__scroll" aria-label="Scroll para ver mais">
        <span class="hero__scroll-label">Desça para ver mais</span>
        <svg width="20" height="28" viewBox="0 0 20 28" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="18" height="26" rx="9" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
          <circle cx="10" cy="8" r="2.5" fill="rgba(255,255,255,0.7)" class="scroll-dot"/>
        </svg>
      </a>
    </div>
  </section>

  {dropCard && (
  <section id="drop-atual" class="section drop-now-section" aria-label={generalDrop?.title}>
    <div class="section-content drop-now-wrap">
      <ProductCarousel
        products={[...dropProducts, ...outros]}
        lang={lang}
        title={dropCard.title}
        headingId="drop-atual-title"
        align="center"
        alwaysControls
      />
    </div>
  </section>
  )}

  {dropCards.length > 0 && (
  <section id="collection" class="section collections-section" aria-labelledby="collections-title">
    <div class="section-content collections-wrap">
      <h2 class="collections-title section__title" id="collections-title">Drops</h2>
      <div
        class:list={['carousel-stage', { 'carousel-stage--single': dropCards.length === 1 }]}
        id="carousel-stage"
        role="region"
        aria-label="Collections"
      >
        <div class="carousel-track" id="carousel-track">
          {dropCards.map((col, i) => (
            <article
              class={`col-card${i === 0 ? ' is-active' : ''}`}
              data-index={i}
              role="listitem"
            >
              <a href={col.href} class="col-card__link">
                <img
                  src={getCollectionImage(col)}
                  style={col.isDrop ? 'object-position: left center' : undefined}
                  alt={col.title}
                  onerror="this.src='/no-data.webp'"
                  class="col-card__img"
                  width="260" height="400"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                />
                {col.count === 0 && (
                  <div class="col-card__ribbon"><span>ESGOTADO</span></div>
                )}
                <div class="col-card__content">
                  <h3 class="col-card__name">{col.title}</h3>
                  <p class="col-card__count">{col.count} itens disponíveis</p>
                  <span class="col-card__cta">{col.isDrop ? 'Ver loja →' : 'Ver coleção →'}</span>
                </div>
              </a>
            </article>
          ))}
        </div>
        <button class="carousel-nav carousel-nav--prev" id="col-prev" aria-label="Anterior" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button class="carousel-nav carousel-nav--next" id="col-next" aria-label="Próximo" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </button>
        <div class="carousel-dots" id="carousel-dots" role="tablist">
          {dropCards.map((_, i) => (
            <button
              class={`carousel-dot${i === 0 ? ' is-active' : ''}`}
              aria-label={`Coleção ${i + 1}`}
              data-idx={i}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            ></button>
          ))}
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- EDITORIAL -->
  <section id="editorial" class="section editorial-section" aria-labelledby="editorial-title">
    <div class="container section-content">
      <header class="section__header section__header--centered">
        <h2 class="section__title" id="editorial-title">{t(lang, 'sections', 'social_title')}</h2>
      </header>
      <div class="editorial__content">
        <ul class="editorial__social" role="list" aria-label="Redes e comunidade">
            <li>
              <a
                class="editorial__social-link"
                href="https://www.instagram.com/tyer_br"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Instagram @tyer_br"
              >
                <img
                  class="editorial__social-ico"
                  src="/icons/instagram.svg"
                  width="32"
                  height="32"
                  alt=""
                  decoding="async"
                />
              </a>
            </li>
            <li>
              <a
                class="editorial__social-link"
                href="https://www.tiktok.com/@tyer_br"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="TikTok @tyer_br"
              >
                <img
                  class="editorial__social-ico"
                  src="/icons/tiktok.svg"
                  width="32"
                  height="32"
                  alt=""
                  decoding="async"
                />
              </a>
            </li>
            <li>
              <a
                class="editorial__fam-link"
                href={WHATSAPP_GROUP_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Grupo Família tyer no WhatsApp"
              >
                <img
                  class="editorial__fam-img"
                  src="/tyer-fam.webp"
                  alt=""
                  width="36"
                  height="36"
                  loading="lazy"
                  decoding="async"
                />
              </a>
            </li>
          </ul>

        <div class="editorial__left">
          <img src="/icons/youtube.svg" alt="" width="40" height="40" class="editorial__left-icon" decoding="async" />
          <span class="editorial__left-dash" aria-hidden="true">—</span>
          <span class="editorial__left-label">Tyer BasketBall</span>
        </div>
        <div class="editorial__right">
          <a
            class="editorial__right-link"
            href={YOUTUBE_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Conteúdos Tyer no YouTube"
          >
            <img
              src="/editorial-right-image.webp"
              alt="Conteúdos e basketball"
              width="560"
              height="400"
              class="editorial__right-img"
              loading="lazy"
              decoding="async"
              onerror="this.src='/no-data.webp'"
            />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- HISTORY — no background image, uses site default bg -->
  <section id="historia" class="section history-section" aria-labelledby="history-title">
    <div class="section-content history-content">
      <div class="history__text">
        <h2 class="history__title" id="history-title">Isso é Tyer!</h2>
        <p class="history__text-body">A TYER nasceu do basquete.</p>
        <p class="history__text-body">Fomos a primeira marca <em>nacional</em> 100% nichada e dedicada a quem realmente ama o jogo. Mas, com o tempo, percebemos que não fomos feitos <em>APENAS</em> para vender roupas maneiras para vocês jogarem.</p>
        <p class="history__text-body">Construímos algo maior!</p>
        <p class="history__text-body">Viramos uma comunidade. Uma família. Uma gang unida pelo mesmo propósito, pela mesma paixão e, principalmente, pelo mesmo jogo...</p>
        <p class="history__text-body">A TYER foi criada por pessoas que vivem o basquete <em>TODOS OS DIAS</em>. Gente que joga, assiste, cria, trabalha, treina, erra, aprende e volta para a quadra no dia seguinte querendo ser melhor.</p>
        <p class="history__text-body"><em>Isso é ser TYER.</em><br /><em>Isso é TYER GANG.</em></p>
        <p class="history__text-body">Não importa se você está começando agora, jogando na rua com os amigos ou disputando nas maiores quadras do país. <em>Estaremos com vocês!</em></p>
        <p class="history__text-body">Acreditamos que existe um verdadeiro atleta dentro de cada um de nós, e é por essas pessoas que existimos!</p>
        <p class="history__text-body">Queremos fortalecer a cultura do basquete, contar histórias reais, valorizar quem vive o jogo e apoiar quem está fazendo o basquete crescer no Brasil.</p>
        <p class="history__text-body"><em>Estamos em todos os lugares, elevando o nível e levando o basquete cada vez mais longe.</em></p>
        <p class="history__text-body">Porque, para nós, basquete nunca foi apenas uma modalidade...</p>
        <p class="history__text-body">É cultura.<br />É identidade.<br />É comunidade.<br />É família.</p>
        <p class="history__text-body"><em>Não vestimos basquete.</em><br /><em>Somos basquete.</em></p>
        <p class="history__text-body"><em>TYER GANG.</em></p>
      </div>
      <div class="history__image">
        <a class="history__more" href={HISTORY_VIDEO_URL} target="_blank" rel="noopener">Clique aqui para assistir o trailer oficial da Tyer</a>
        <a href={HISTORY_VIDEO_URL} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
          <video class="history__video" muted loop playsinline preload="none" poster="/video/historia-poster.webp" width="1280" height="720" aria-hidden="true">
            <source src="/video/historia.webm" type="video/webm" />
            <source src="/video/historia.mp4" type="video/mp4" />
          </video>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
/* ── Hero ── */
.hero {
  position: relative; min-height: 100svh;
  display: flex; align-items: center; justify-content: center;
  overflow: hidden;
  margin-top: calc(-1 * var(--header-h));
}
.hero__picture {
  position: absolute;
  inset: 0;
  z-index: 0;
  opacity: 1;
  transition: opacity 0.45s ease;
}
.hero__picture.is-hidden {
  opacity: 0;
}
.hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.hdr:has(.hdr__nav-item--mega:hover) {
  background: var(--c-bg); /* Match megamenu background */
  backdrop-filter: none;
}
.hdr__inner { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
.hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 0;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.45s ease;
}
.hero__video.is-ready {
  opacity: 1;
  visibility: visible;
}
.hero__overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(to bottom, rgba(0,0,0,.75) 0%, transparent); }
/* Countdown e "desça para ver mais" empilhados num único container em fluxo
   normal — antes eram dois `position:absolute` com `bottom` fixo cada um,
   e colidiam sempre que o countdown crescia (form de pre-save aparecendo)
   ou a viewport encolhia. Assim, qualquer altura do countdown empurra o
   scroll indicator, nunca sobrepõe. */
.hero__bottom-stack {
  position: absolute;
  left: 50%;
  bottom: 28px;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  max-width: calc(100% - 32px);
}
.hero__countdown {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  text-align: center;
  padding: 16px 24px;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 14px;
  color: #fff;
}
.hero__countdown-label { font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-accent, #e77e23); margin: 0; }
.hero__countdown-clock { display: flex; gap: 14px; }
.hero__countdown-unit { display: flex; flex-direction: column; align-items: center; min-width: 42px; }
.hero__countdown-num { font-family: var(--font-title); font-size: 28px; line-height: 1; }
.hero__countdown-u { font-size: 9px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(255, 255, 255, 0.6); margin-top: 2px; }
.hero__countdown.is-over .hero__countdown-clock { opacity: 0.4; }
.hero__presave { display: flex; gap: 8px; margin-top: 4px; flex-wrap: wrap; justify-content: center; }
.hero__presave-input {
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
  font-size: 13px;
  min-width: 180px;
}
.hero__presave-input::placeholder { color: rgba(255, 255, 255, 0.5); }
.hero__presave-btn {
  /* Branco em cima do laranja (#e77e23) fica ~2.8:1 — abaixo do 4.5:1 do
     WCAG 2.1 AA pra texto normal. Preto no mesmo fundo dá ~7.4:1. */
  background: var(--c-accent, #e77e23);
  color: var(--c-black, #000);
  border: 1px solid var(--c-accent, #e77e23);
  border-radius: 8px;
  padding: 8px 16px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.03em;
  text-transform: uppercase;
  cursor: pointer;
  transition: background 0.15s ease;
}
.hero__presave-btn:hover { background: var(--c-accent-d, #c96a10); }
.hero__presave-feedback { font-size: 12px; margin: 2px 0 0; }
.hero__presave-feedback.is-ok { color: #7dffb2; }
.hero__presave-feedback.is-err { color: #ff8a8a; }
@media (max-width: 560px) {
  .hero__bottom-stack { bottom: 16px; gap: 10px; }
  .hero__countdown { padding: 12px 16px; }
  .hero__countdown-num { font-size: 22px; }
}
.hero__scroll {
  color: rgba(255,255,255,0.6); transition: color var(--ease);
  display: flex; flex-direction: column; align-items: center; gap: 12px;
}
.hero__scroll:hover { color: rgba(255,255,255,0.9); }
.hero__scroll-label { font-size: 11px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
.scroll-dot { animation: scrollpulse 2s ease-in-out infinite; }
@keyframes scrollpulse { 0%,100% { cy: 8; opacity: 1; } 50% { cy: 16; opacity: 0.4; } }

/* ── Section base ── */
.section { position: relative; min-height: 75svh; display: flex; align-items: center; overflow: hidden; }
.section-content { position: relative; z-index: 2; width: 100%; padding-block: 64px; }

/* ── Section header ── */
.section__header { margin-bottom: 48px; display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 24px; }
.section__header--centered { justify-content: center; text-align: center; }
.section__title { font-family: var(--font-title); font-size: clamp(36px, 5vw, 64px); text-transform: uppercase; flex: 1 0 100%; }
.products-section__actions {
  display: flex;
  justify-content: center;
  margin-top: 40px;
  margin-bottom: 0;
}
.products-section__cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border-radius: 9999px;
  padding: 12px 28px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  text-align: center;
}
.products-section__cta-txt { line-height: 1.2; }
.products-section__cta-ico { flex-shrink: 0; opacity: 0.9; }
.products-section__cta:hover .products-section__cta-ico, .products-section__cta:focus-visible .products-section__cta-ico {
  transform: translateX(2px);
  transition: transform 0.2s ease;
}

/* ── Products (usa ProductCard) ── */
/* Só sobra pro fallback de skeleton (products.length === 0) — a fileira
   real usa <ProductCarousel>, que traz seu próprio CSS/scroll/setas. */
.products-showcase-wrap {
  width: 100%;
  min-width: 0;
}
.products-showcase-viewport { width: 100%; min-width: 0; }
.products-showcase { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; align-items: stretch; }
.products-showcase > :global(*) { min-width: 0; }
@media (max-width: 900px) { .products-showcase { grid-template-columns: repeat(2, 1fr); } }

.product-showcase-card {
  transition: transform 0.3s ease;
}
.product-showcase-card:hover { transform: translateY(-4px); }
.psc__link { display: block; height: 100%; text-decoration: none; }
.psc__img-wrap {
  aspect-ratio: 1;
  position: relative;
  background: var(--c-bg-mute, #1a1a1a);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 8px; /* Soft moldura */
  overflow: hidden;
  margin-bottom: 12px;
}
.psc__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.psc__link:hover .psc__img { transform: scale(1.06); }
.psc__img--skel { background: linear-gradient(110deg, #1a1a1a 30%, #2a2a2a 50%, #1a1a1a 70%); background-size: 200% 100%; animation: shimmer 1.5s infinite; }
@keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
.psc__info { text-align: center; padding: 0 4px; }
.psc__name {
  font-size: 14px;
