<style>
.hero__drop { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; color: #fff; text-decoration: none; padding: 16px 28px; background: rgba(0, 0, 0, 0.55); border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 14px; backdrop-filter: blur(6px); }
