<script>
  // @ts-nocheck
  (function () {
  
    /* ─────────────────────────────────────────────
       HERO VIDEO LAZY INIT
    ───────────────────────────────────────────── */
  
    const heroVideo   = document.querySelector('.hero__video');
    const heroPicture = document.querySelector('.hero__picture');
  
    if (heroVideo && heroPicture) {
  
      function startHeroVideo() {
  
        // evita iniciar duas vezes
        if (heroVideo.dataset.started) return;
        heroVideo.dataset.started = 'true';
  
        // força load
        heroVideo.load();
  
        heroVideo.addEventListener('canplaythrough', async () => {
          try {
  
            await heroVideo.play();
  
            heroVideo.classList.add('is-ready');
            heroPicture.classList.add('is-hidden');
  
          } catch (err) {
            console.error('Video autoplay failed:', err);
          }
        }, { once: true });
      }
  
      // inicia quando entrar na viewport
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
  
          if (entry.isIntersecting) {
            startHeroVideo();
            observer.disconnect();
          }
  
        });
      }, {
        threshold: 0.35
      });
  
      observer.observe(heroVideo);
    }

    /* Vídeo da história: só baixa e toca quando chega perto da tela. */
    (function () {
      const v = document.querySelector('.history__video');
      if (!v) return;
      new IntersectionObserver((entries, obs) => {
        if (!entries[0].isIntersecting) return;
        obs.disconnect();
        v.preload = 'auto';
        v.play().catch(() => {});
      }, { rootMargin: '200px' }).observe(v);
    })();

    /* Mais Vendidos: setas/scroll agora são do <ProductCarousel>
       (product-carousel-client.ts, importado globalmente no Layout). */

    /* ─────────────────────────────────────────────
       CAROUSEL (drops)
    ───────────────────────────────────────────── */
  
    (function initDropsCarousel() {
    const stage   = document.getElementById('carousel-stage');
    const track   = document.getElementById('carousel-track');
    const prevBtn = document.getElementById('col-prev');
    const nextBtn = document.getElementById('col-next');
    const dotsEl  = document.getElementById('carousel-dots');
  
    if (!stage || !track) return;
  
    const cards = Array.from(track.querySelectorAll('.col-card'));
    const dots  = dotsEl ? Array.from(dotsEl.querySelectorAll('.carousel-dot')) : [];
    const n = cards.length;
  
    let current = 0;
    let autoTimer;
  
    if (n === 1) {
      const card = cards[0];
      card.style.transform = 'translateX(0) scale(1)';
      card.style.opacity = '1';
      card.style.zIndex = '5';
      card.style.filter = 'grayscale(0%)';
      card.style.pointerEvents = 'all';
      card.classList.add('is-active');
      card.setAttribute('aria-current', 'true');
      return;
    }
  
    const SLOTS = [
      { x: -430, scale: 0.62, opacity: 0.35, zi: 1 },
      { x: -238, scale: 0.80, opacity: 0.60, zi: 2 },
      { x:    0, scale: 1.00, opacity: 1.00, zi: 5 },
      { x:  238, scale: 0.80, opacity: 0.60, zi: 2 },
      { x:  430, scale: 0.62, opacity: 0.35, zi: 1 },
    ];
  
    const HALF = Math.floor(SLOTS.length / 2);
  
    function applySlot(card, slot, isActive) {
      card.style.transform = 'translateX(' + slot.x + 'px) scale(' + slot.scale + ')';
      card.style.opacity = String(slot.opacity);
      card.style.zIndex = String(slot.zi);
      card.style.filter = isActive ? 'grayscale(0%)' : 'grayscale(100%)';
      card.style.pointerEvents = 'all';
      card.classList.toggle('is-active', isActive);
      card.setAttribute('aria-current', isActive ? 'true' : 'false');
    }

    function positionCards(activeIdx) {
      if (n >= 5) {
        cards.forEach((card, i) => {
          let rel = ((i - activeIdx) % n + n) % n;
          if (rel > n - 1 - HALF) rel -= n;
          const slotIdx = rel + HALF;
          if (slotIdx < 0 || slotIdx >= SLOTS.length) {
            card.style.transform = 'translateX(0) scale(0.3)';
            card.style.opacity = '0';
            card.style.zIndex = '0';
            card.style.pointerEvents = 'none';
            card.classList.remove('is-active');
            return;
          }
          const slot = SLOTS[slotIdx];
          applySlot(card, slot, slotIdx === HALF);
        });
      } else {
        cards.forEach((card, i) => {
          const forward = (i - activeIdx + n) % n;
          let slot;
          if (n === 2) {
            if (forward === 0) slot = SLOTS[2];
            else slot = i < activeIdx ? SLOTS[1] : SLOTS[3];
          } else if (n === 3) {
            slot = SLOTS[[2, 3, 1][forward]];
          } else if (n === 4) {
            slot = SLOTS[[2, 3, 4, 1][forward]];
          } else {
            slot = SLOTS[2];
          }
          applySlot(card, slot, forward === 0);
        });
      }

      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === activeIdx);
        dot.setAttribute('aria-selected', i === activeIdx ? 'true' : 'false');
      });
    }
  
    function goTo(idx) {
      current = ((idx % n) + n) % n;
      positionCards(current);
    }
  
    function startAuto() {
      clearInterval(autoTimer);
      autoTimer = setInterval(() => goTo(current + 1), 4500);
    }
  
    function stopAuto() {
      clearInterval(autoTimer);
    }
  
    positionCards(0);
  
    prevBtn?.addEventListener('click', () => {
      goTo(current - 1);
      stopAuto();
      startAuto();
    });
  
    nextBtn?.addEventListener('click', () => {
      goTo(current + 1);
      stopAuto();
      startAuto();
    });
  
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        goTo(i);
        stopAuto();
        startAuto();
      });
    });
  
    cards.forEach((card, i) => {
  
      card.addEventListener('click', (e) => {
  
        if (i !== current) {
  
          e.preventDefault();
  
          goTo(i);
  
          stopAuto();
          startAuto();
        }
      });
    });
  
    stage.setAttribute('tabindex', '0');
  
    stage.addEventListener('keydown', (e) => {
  
      if (e.key === 'ArrowLeft') {
        goTo(current - 1);
        stopAuto();
        startAuto();
      }
  
      if (e.key === 'ArrowRight') {
        goTo(current + 1);
        stopAuto();
        startAuto();
      }
    });
  
    // Só o foco por teclado pausa: pausar no hover pararia o carrossel de quem deixa o mouse em cima, e no toque ele nunca voltaria.
    stage.addEventListener('focusin', (e) => { if (e.target.matches(':focus-visible')) stopAuto(); });
    stage.addEventListener('focusout', startAuto);

    // Gira só enquanto o carrossel está visível e a aba aberta.
    let visible = true;
    const sync = () => (visible && !document.hidden ? startAuto() : stopAuto());
    new IntersectionObserver((entries) => {
      visible = entries[0].isIntersecting;
      sync();
    }, { threshold: 0.2 }).observe(stage);
    document.addEventListener('visibilitychange', sync);

    startAuto();
    })();

    /* ─────────────────────────────────────────────
       HERO COUNTDOWN + PRE-SAVE
    ───────────────────────────────────────────── */
    (function () {
      const box = document.getElementById('hero-countdown');
      if (!box) return;
      const targetIso = box.dataset.targetIso;
      const target = targetIso ? new Date(targetIso).getTime() : NaN;
      if (!Number.isFinite(target)) return;

      const dEl = box.querySelector('[data-cd="d"]');
      const hEl = box.querySelector('[data-cd="h"]');
      const mEl = box.querySelector('[data-cd="m"]');
      const sEl = box.querySelector('[data-cd="s"]');
      const pad = (n) => String(Math.max(0, n)).padStart(2, '0');

      function tick() {
        const diff = target - Date.now();
        if (diff <= 0) {
          if (dEl) dEl.textContent = '00';
          if (hEl) hEl.textContent = '00';
          if (mEl) mEl.textContent = '00';
          if (sEl) sEl.textContent = '00';
          box.classList.add('is-over');
          clearInterval(timer);
          return;
        }
        const totalSec = Math.floor(diff / 1000);
        const days = Math.floor(totalSec / 86400);
        const hours = Math.floor((totalSec % 86400) / 3600);
        const mins = Math.floor((totalSec % 3600) / 60);
        const secs = totalSec % 60;
        if (dEl) dEl.textContent = pad(days);
        if (hEl) hEl.textContent = pad(hours);
        if (mEl) mEl.textContent = pad(mins);
        if (sEl) sEl.textContent = pad(secs);
      }
      tick();
      const timer = setInterval(tick, 1000);

      const form = document.getElementById('hero-presave-form');
      const feedback = document.getElementById('hero-presave-feedback');
      form?.addEventListener('submit', async (ev) => {
        ev.preventDefault();
        const input = form.querySelector('input[type="email"]');
        const email = input ? input.value.trim() : '';
        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          if (feedback) { feedback.hidden = false; feedback.textContent = 'E-mail inválido.'; feedback.className = 'hero__presave-feedback is-err'; }
          return;
        }
        const btn = form.querySelector('button[type="submit"]');
        if (btn) btn.disabled = true;
        try {
          const apiUrl = form.dataset.apiUrl || '';
          const res = await fetch(apiUrl + '/api/newsletter', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email }),
          });
          if (!res.ok) throw new Error('fail');
          if (feedback) { feedback.hidden = false; feedback.textContent = 'Pre-save feito! Avisamos você.'; feedback.className = 'hero__presave-feedback is-ok'; }
          form.hidden = true;
        } catch {
          if (feedback) { feedback.hidden = false; feedback.textContent = 'Não deu certo agora. Tente de novo.'; feedback.className = 'hero__presave-feedback is-err'; }
        } finally {
          if (btn) btn.disabled = false;
        }
      });
    })();

  })();
</script>
