---
import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl, t, getPathForLang } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getLookbookDrop, lookbookPhotos, LOOKBOOK_DROPS } from '../../lib/lookbook';

export const prerender = false;

const lang: Lang = getLangFromUrl(Astro.url);
const drop = getLookbookDrop(String(Astro.params.slug ?? ''));
if (!drop) Astro.response.status = 404;

const photos = drop ? lookbookPhotos(drop) : [];
const others = LOOKBOOK_DROPS.filter((d) => d.slug !== drop?.slug);
---

<Layout
  title={drop ? `${drop.title} — ${t(lang, 'lookbook', 'title')} — Tyer` : t(lang, 'lookbook', 'not_found_title')}
  description={drop ? t(lang, 'lookbook', 'drop_description').replace('{title}', drop.title) : t(lang, 'lookbook', 'not_found_desc')}
  lang={lang}
  ogImage={drop ? photos[0].src : '/logo.webp'}
  noindex={!drop}
>
  {
    drop ? (
      <main class="lb-page">
        <header class="lb-head container">
          <nav class="lb-crumb" aria-label="Breadcrumb">
            <a href={getPathForLang('/lookbook', lang)}>‹ {t(lang, 'lookbook', 'title')}</a>
          </nav>
          <h1 class="lb-head__title">{drop.title}</h1>
          <p class="lb-head__count">
            {drop.count} {t(lang, 'lookbook', 'looks')}
          </p>
        </header>

        <div class="lb-gallery container">
          {photos.map((p, i) => (
            <a
              href={p.src}
              class:list={['lb-photo', { 'lb-photo--wide': p.wide }]}
              data-lb-item
              aria-label={`${drop.title} — ${i + 1}`}
            >
              <img
                src={p.src}
                alt={`${drop.title} — look ${i + 1}`}
                width={p.wide ? 1600 : 1080}
                height={p.wide ? 1082 : 1440}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
          ))}
          {drop.video && (
            <div class="lb-photo lb-photo--video">
              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                poster={`/lookbook/${drop.slug}/video-poster.webp`}
                aria-label={`${drop.title} — vídeo`}
              >
                <source src={`/lookbook/${drop.slug}/video.webm`} type="video/webm" />
                <source src={`/lookbook/${drop.slug}/video.mp4`} type="video/mp4" />
              </video>
            </div>
          )}
        </div>

        <section class="lb-more container" aria-label={t(lang, 'lookbook', 'more')}>
          <h2 class="lb-more__title">{t(lang, 'lookbook', 'more')}</h2>
          <ul class="lb-more__list">
            {others.map((d) => (
              <li>
                <a href={getPathForLang(`/lookbook/${d.slug}`, lang)}>{d.title}</a>
              </li>
            ))}
          </ul>
          <a href={getPathForLang('/shop', lang)} class="btn btn-outline">
            {t(lang, 'lookbook', 'shop_cta')}
          </a>
        </section>

        <div class="lb-viewer" id="lb-viewer" hidden role="dialog" aria-modal="true" aria-label={drop.title}>
          <button type="button" class="lb-viewer__btn lb-viewer__close" data-lb-close aria-label={t(lang, 'pdp', 'lightbox_close')}>×</button>
          <button type="button" class="lb-viewer__btn lb-viewer__prev" data-lb-prev aria-label={t(lang, 'pdp', 'lightbox_prev')}>‹</button>
          <img class="lb-viewer__img" alt="" data-lb-img />
          <button type="button" class="lb-viewer__btn lb-viewer__next" data-lb-next aria-label={t(lang, 'pdp', 'lightbox_next')}>›</button>
        </div>
      </main>
    ) : (
      <div class="lb-nf container">
        <p class="lb-nf__code">404</p>
        <h1 class="lb-nf__title">{t(lang, 'lookbook', 'not_found_title')}</h1>
        <p class="lb-nf__sub">{t(lang, 'lookbook', 'not_found_desc')}</p>
        <a class="btn btn-primary" href={getPathForLang('/lookbook', lang)}>
          {t(lang, 'lookbook', 'title')}
        </a>
      </div>
    )
  }
</Layout>

<script>
  const viewer = document.getElementById('lb-viewer');
  const img = viewer?.querySelector<HTMLImageElement>('[data-lb-img]');
  const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-lb-item]'));
  let current = 0;

  function show(i: number) {
    if (!viewer || !img || !items.length) return;
    current = (i + items.length) % items.length;
    img.src = items[current].href;
    viewer.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function close() {
    if (!viewer) return;
    viewer.hidden = true;
    document.body.style.overflow = '';
  }

  items.forEach((a, i) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
    })
  );
  viewer?.querySelector('[data-lb-close]')?.addEventListener('click', close);
  viewer?.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
  viewer?.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
  viewer?.addEventListener('click', (e) => {
    if (e.target === viewer) close();
  });
  document.addEventListener('keydown', (e) => {
    if (!viewer || viewer.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(current - 1);
    else if (e.key === 'ArrowRight') show(current + 1);
  });
</script>

<style>
  .container {
    max-width: var(--max-w, 1200px);
    margin-inline: auto;
    width: 100%;
    box-sizing: border-box;
  }
  .lb-page {
    padding: calc(var(--header-h) + 32px) 0 72px;
  }
  .lb-head {
    margin-bottom: 32px;
  }
  .lb-crumb a {
    font-size: 12px;
    color: var(--c-muted);
    text-decoration: none;
  }
  .lb-crumb a:hover {
    color: var(--c-accent);
  }
  .lb-head__title {
    font-family: var(--font-title);
    font-size: clamp(40px, 7vw, 84px);
    text-transform: uppercase;
    line-height: 0.95;
    margin: 14px 0 10px;
  }
  .lb-head__count {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--c-muted);
  }

  .lb-gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    grid-auto-flow: dense;
  }
  .lb-photo {
    display: block;
    overflow: hidden;
    border-radius: var(--r-md, 6px);
    background: var(--c-surface2);
  }
  .lb-photo--wide {
    grid-column: span 2;
  }
  .lb-photo--video {
    aspect-ratio: 3 / 4;
  }
  .lb-photo--video video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lb-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .lb-photo:hover img {
    transform: scale(1.03);
  }

  .lb-more {
    margin-top: 64px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
  }
  .lb-more__title {
    font-family: var(--font-title);
    font-size: 28px;
    text-transform: uppercase;
    margin: 0;
  }
  .lb-more__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }
  .lb-more__list a {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--c-text);
    text-decoration: none;
  }
  .lb-more__list a:hover {
    color: var(--c-accent);
  }

  .lb-viewer {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.94);
  }
  .lb-viewer[hidden] {
    display: none;
  }
  .lb-viewer__img {
    max-width: min(92vw, 1200px);
    max-height: 90vh;
    object-fit: contain;
  }
  .lb-viewer__btn {
    position: absolute;
    background: none;
    border: 0;
    color: #fff;
    font-size: 40px;
    line-height: 1;
    padding: 12px 18px;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .lb-viewer__btn:hover {
    color: var(--c-accent);
  }
  .lb-viewer__close {
    top: 12px;
    right: 12px;
  }
  .lb-viewer__prev {
    left: 8px;
  }
  .lb-viewer__next {
    right: 8px;
  }

  .lb-nf {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    padding: 48px 20px;
  }
  .lb-nf__code {
    font-family: var(--font-title);
    font-size: clamp(64px, 12vw, 120px);
    margin: 0;
    color: var(--c-accent);
  }
  .lb-nf__title {
    font-family: var(--font-title);
    font-size: clamp(28px, 5vw, 44px);
    text-transform: uppercase;
    margin: 0;
  }
  .lb-nf__sub {
    color: var(--c-muted);
    margin: 0 0 12px;
  }

  @media (max-width: 780px) {
    .lb-gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
  }
</style>
