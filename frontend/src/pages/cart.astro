---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, t, getPathForLang } from '../i18n/utils';
import type { Lang } from '../i18n/utils';
const lang: Lang = getLangFromUrl(Astro.url);
---
<Layout title={t(lang, 'cart', 'your_cart')} lang={lang} noindex>
  <div class="cart-page container">
    <h1 class="cart-page__title">{t(lang, 'cart', 'your_cart')}</h1>
    <div class="cart-shell">
      <section class="cart-shell__items">
        <div class="sc__body" id="cart-items" role="list" aria-label={t(lang, 'cart', 'items')}>
          <div class="sc__empty" id="cart-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M4.92 8.02 L4.69 9.33 L4.69 10.78 L4.88 11.25 L5.25 11.67 L5.91 11.95 L10.83 11.95 L10.83 11.11 L11.11 10.83 L12.94 10.88 L13.12 11.11 L13.12 11.95 L18.05 11.95 L18.70 11.67 L19.08 11.25 L19.27 10.78 L19.27 9.33 L19.08 8.20 L18.75 7.27 L18.05 6.09 L17.16 5.16 L16.22 4.50 L15.00 3.98 L13.88 3.80 L13.78 2.86 L13.45 2.20 L12.98 1.78 L12.23 1.50 L11.34 1.59 L10.83 1.88 L10.50 2.20 L10.17 2.86 L10.08 3.80 L9.28 3.89 L8.30 4.22 L6.84 5.11 L6.09 5.86 L5.58 6.56 Z M4.59 2.53 L3.56 7.92 L3.38 14.16 L2.67 14.77 L2.25 15.80 L2.39 20.30 L2.81 20.58 L4.31 20.58 L4.41 21.42 L5.11 22.27 L5.20 17.77 L5.53 17.02 L6.28 16.50 L17.44 16.45 L18.19 16.78 L18.75 17.77 L18.84 22.27 L19.55 21.42 L19.64 20.58 L21.38 20.48 L21.70 20.02 L21.70 15.80 L21.28 14.77 L20.58 14.16 L20.39 7.92 L19.36 2.53 L18.94 6.00 L19.97 8.53 L20.16 13.97 L19.36 13.83 L19.31 12.14 L18.09 12.75 L13.12 12.75 L13.12 13.59 L12.84 13.88 L11.02 13.83 L10.83 12.75 L5.86 12.75 L4.64 12.14 L4.59 13.83 L3.80 13.97 L3.98 8.53 L5.02 6.00 Z M6.05 17.67 L5.91 22.45 L18.05 22.45 L17.95 17.81 L17.81 17.53 L17.53 17.30 L6.56 17.25 L6.28 17.39 Z M7.45 6.09 L7.64 5.86 L8.11 5.53 L8.34 5.44 L8.53 5.30 L8.62 5.30 L8.86 5.16 L9.42 4.97 L9.61 4.97 L9.89 4.88 L10.17 4.88 L10.22 4.83 L13.73 4.83 L13.78 4.88 L14.34 4.92 L14.72 5.06 L14.86 5.06 L15.52 5.34 L16.31 5.86 L16.50 6.09 L16.50 6.33 L16.31 6.56 L16.22 6.61 L15.98 6.61 L15.33 6.14 L14.95 5.95 L14.86 5.95 L14.44 5.77 L14.06 5.72 L14.02 5.67 L13.73 5.67 L13.69 5.62 L10.27 5.62 L10.22 5.67 L9.94 5.67 L9.89 5.72 L9.52 5.77 L9.09 5.95 L9.00 5.95 L8.48 6.23 L7.97 6.61 L7.73 6.61 L7.64 6.56 L7.45 6.33 Z M8.02 1.64 L7.97 1.64 L7.73 1.50 L5.91 1.50 L5.86 1.55 L5.77 1.55 L5.67 1.64 L5.62 1.64 L5.48 1.78 L5.48 1.83 L5.39 1.92 L5.39 2.02 L5.34 2.06 L5.34 2.39 L5.39 2.44 L5.39 2.77 L5.44 2.81 L5.44 3.14 L5.48 3.19 L5.48 3.52 L5.53 3.56 L5.53 3.89 L5.