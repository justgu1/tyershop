---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLangFromUrl } from '../../i18n/utils';
import type { Lang } from '../../i18n/utils';
import { getPublishableKey } from '../../lib/medusa-env';
const lang: Lang = getLangFromUrl(Astro.url);
const pk = getPublishableKey();
---
<Layout title="Redefinir senha" lang={lang} noindex>
  <div class="account-page container">
    <h1 class="account-page__title">Redefinir senha</h1>

    <form id="reset-form" class="account-form" novalidate>
      <p class="account-form__hint" id="reset-intro">Escolha uma nova senha pra sua conta Tyer.</p>
      <div class="account-form__field">
        <label for="reset-password-1">Nova senha</label>
        <input id="reset-password-1" type="password" autocomplete="new-password" required minlength="6" />
      </div>
      <div class="account-form__field">
        <label for="reset-password-2">Confirmar nova senha</label>
        <input id="reset-password-2" type="password" autocomplete="new-password" required minlength="6" />
      </div>
      <p class="account-form__status" id="reset-status" hidden></p>
      <button type="submit" class="btn btn-primary" id="reset-submit">Salvar nova senha</button>
    </form>

    <div id="reset-invalid" class="account-form" hidden>
      <p class="account-form__hint">Esse link expirou ou já foi usado. Digite seu e-mail pra receber um novo.</p>
      <div class="account-form__field">
        <label for="reset-retry-email">E-mail</label>
        <input id="reset-retry-email" type="email" autocomplete="email" />
      </div>
      <p class="account-form__status" id="reset-retry-status" hidden></p>
      <button type="button" class="btn btn-primary" id="reset-retry-submit">Enviar novo link</button>
    </div>
  </div>
</Layout>

<style>
.account-page { padding-block: 64px; max-width: 480px; }
.account-page__title { font-family: var(--font-title); font-size: 44px; text-transform: uppercase; margin-bottom: 24px; }
.account-form { display:flex; flex-direction:column; gap:12px; padding:16px; border:1px solid var(--c-border); border-radius: var(--r-md); background: var(--c-surface); margin-top: 16px; }
.account-form__field { display:flex; flex-direction:column; gap:6px; }
.account-form__field label { font-size:11px; text-transform: uppercase; letter-spacing:.08em; color: var(--c-muted); }
.account-form__field input { background:#0d0d0d; border:1px solid #2a2a2a; border-radius: var(--r); min-height:36px; padding:0 10px; color:var(--c-text); }
.account-form__status { font-size:12px; color:var(--c-muted); }
.account-form__status.is-error { color: #fca5a5; }
.account-form__hint { font-size: 13px; color: var(--c-muted); line-height: 1.45; }
</style>

<script define:vars={{ pk }}>
  (function () {
    function base64UrlDecode(str) {
      const padded = str.replace(/-/g, '+').replace(/_/g, '/');
      const pad = padded.length % 4 === 0 ? '' : '='.repeat(4 - (padded.length % 4));
      return atob(padded + pad);
    }
    function decodeJwtEntityId(token) {
      try {
        const payload = JSON.parse(base64UrlDecode(token.split('.')[1]));
        return payload.entity_id || '';
      } catch {
        return '';
      }
    }
    // Decodificar aqui é só pra UX (saber pra quem logar depois de trocar
    // a senha) — a validação de verdade acontece no backend, com a
    // assinatura do token, quando ele for de fato usado no /update.
    const params = new URLSearchParams(window.location.search);
    const token = params.get('token') || '';
    const entityId = token ? decodeJwtEntityId(token) : '';

    const form = document.getElementById('reset-form');
    const invalidBlock = document.getElementById('reset-invalid');
    const statusEl = document.getElementById('reset-status');
    const submitBtn = document.getElementById('reset-submit');

    function showInvalid() {
      form.hidden = true;
      invalidBlock.hidden = false;
      const retryEmail = document.getElementById('reset-retry-email');
      if (retryEmail && entityId) retryEmail.value = entityId;
    }

    if (!token) {
      showInvalid();
    }

    async function persistSession(sessionToken) {
      try {
        localStorage.setItem('tyer_token', sessionToken);
        const res = await fetch('/store/customers/me', {
          headers: { authorization: 'Bearer ' + sessionToken, 'x-publishable-api-key': pk },
        });
        if (res.ok) {
          const data = await res.json().catch(() => null);
          if (data && data.customer) localStorage.setItem('tyer_customer', JSON.stringify(data.customer));
        }
      } catch {
        /* sessão local via token já funciona; persistir pro resto do site é bônus */
      }
    }

    function hasCheckoutDraft() {
      try {
        return !!localStorage.getItem('tyer_checkout_draft');
      } catch {
        return false;
      }
    }

    form?.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const p1 = document.getElementById('reset-password-1').value;
      const p2 = document.getElementById('reset-password-2').value;
      statusEl.hidden = true;
      statusEl.classList.remove('is-error');
      if (p1.length < 6) {
        statusEl.hidden = false;
        statusEl.classList.add('is-error');
        statusEl.textContent = 'A senha precisa ter pelo menos 6 caracteres.';
        return;
      }
      if (p1 !== p2) {
        statusEl.hidden = false;
        statusEl.classList.add('is-error');
        statusEl.textContent = 'As senhas não são iguais.';
        return;
      }
      submitBtn.disabled = true;
      try {
        const updateRes = await fetch('/auth/customer/emailpass/update', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            authorization: 'Bearer ' + token,
            'x-publishable-api-key': pk,
          },
          body: JSON.stringify({ password: p1 }),
        });
        if (!updateRes.ok) {
          showInvalid();
          return;
        }
        // /update não devolve sessão — loga de novo com a senha nova pra
        // ter um token de sessão de verdade.
        const loginRes = await fetch('/auth/customer/emailpass', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-publishable-api-key': pk },
          body: JSON.stringify({ email: entityId, password: p1 }),
        });
        if (loginRes.ok) {
          const loginData = await loginRes.json();
          if (loginData.token) await persistSession(loginData.token);
        }
        window.location.href = hasCheckoutDraft() ? '/checkout' : '/account';
      } catch {
        statusEl.hidden = false;
        statusEl.classList.add('is-error');
        statusEl.textContent = 'Não foi possível trocar a senha agora. Tente de novo.';
      } finally {
        submitBtn.disabled = false;
      }
    });

    document.getElementById('reset-retry-submit')?.addEventListener('click', async () => {
      const email = (document.getElementById('reset-retry-email').value || '').trim();
      const retryStatus = document.getElementById('reset-retry-status');
      if (!email) return;
      retryStatus.hidden = false;
      retryStatus.classList.remove('is-error');
      retryStatus.textContent = 'Enviando…';
      try {
        await fetch('/auth/customer/emailpass/reset-password', {
          method: 'POST',
          headers: { 'content-type': 'application/json', 'x-publishable-api-key': pk },
          body: JSON.stringify({ identifier: email }),
        });
      } catch {
        /* segue com a mensagem genérica de qualquer forma */
      }
      retryStatus.textContent = 'Se esse e-mail tiver conta, enviamos um novo link.';
    });
  })();
</script>
