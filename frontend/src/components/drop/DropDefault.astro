---
import Countdown from './Countdown.astro';
import LeadForm from './LeadForm.astro';
import AccessForm from './AccessForm.astro';
import CollectionMosaicItem from '../CollectionMosaicItem.astro';
import SectionBand from './SectionBand.astro';
import type { CatalogSection } from '../../lib/catalog-sections';
import { PHASE_LABEL, type DropAccess, type DropSection, type PublicDrop } from '../../lib/drop';

interface Props {
  drop: PublicDrop;
  access?: DropAccess;
  products?: any[];
  sections?: DropSection[];
  /** O que está à venda fora do drop, em faixas separadas abaixo das peças do drop. */
  others?: CatalogSection[];
}
const { drop, access = 'none', products = [], sections = [], others = [] } = Astro.props;
const { phase } = drop;
const heroBanner = drop.hero_kind === 'banner' ? drop.hero_url : null;
const heroVideo = drop.hero_kind !== 'banner' ? drop.hero_url : null;
const showProducts = access === 'granted' && products.length > 0;
const byId = new Map<string, any>(products.map((p) => [p.id, p]));
const groups = (sections.length ? sections : [{ key: 'all', title: drop.title, label: null, banner_url: null, banner_mobile_url: null, product_ids: products.map((p) => p.id) }])
  .map((s) => ({ ...s, items: s.product_ids.map((id) => byId.get(id)).filter(Boolean) }))
  .filter((s) => s.items.length);
---

{showProducts ? (
  <main class="dc">
    <section class="dc-banner">
      {heroBanner && <img class="dc-banner__img" src={heroBanner} alt="" loading="eager" decoding="async" />}
      {heroVideo && <video class="dc-banner__img" src={heroVideo} autoplay muted loop playsinline aria-hidden="true"></video>}
      <div class="dc-banner__overlay" aria-hidden="true"></div>
      <div class="dc-banner__content container">
        <p class="dc-banner__eyebrow">{PHASE_LABEL[phase]}</p>
        <h1 class="dc-banner__title">{drop.title}</h1>
        {drop.subtitle && <p class="dc-banner__desc">{drop.subtitle}</p>}
        <p class="dc-banner__desc">
          Até 2 peças de cada produto por pessoa. Produção em até {drop.production_days} dias, mais o prazo da transportadora.
        </p>
        <p class="dc-banner__count">{`${products.length} ${products.length === 1 ? 'peça' : 'peças'}`}</p>
      </div>
    </section>
    <div class="container">
    </div>
    {groups.map((s, n) => (
      <section class="dc-section" aria-label={s.title || drop.title}>
        <div class={s.banner_url ? 'dc-section__band dc-section__band--full' : 'container'}>
          <SectionBand index={n + 1} title={s.title || drop.title} label={s.label} bannerUrl={s.banner_url} bannerMobileUrl={s.banner_mobile_url} />
        </div>
        <div class="container">
          <div class="dc-mosaic" role="list" aria-label={s.title || drop.title}>
            {s.items.map((p, i) => <CollectionMosaicItem product={p} lang="pt" reverse={i % 2 === 1} />)}
          </div>
        </div>
      </section>
    ))}
    {others.map((s, n) => (
      <section class="dc-section" aria-label={s.title}>
        <div class="container">
          <SectionBand index={groups.length + n + 1} title={s.title} label="Sempre disponível" />
        </div>
        <div class="container">
          <div class="dc-mosaic" role="list" aria-label={s.title}>
            {s.products.map((p, i) => <CollectionMosaicItem product={p} lang="pt" reverse={i % 2 === 1} />)}
          </div>
        </div>
      </section>
    ))}
  </main>
) : (
<section class={`drop drop--${phase}`}>
  {heroBanner && <img class="drop__bg" src={heroBanner} alt="" loading="eager" decoding="async" />}
  {heroVideo && <video class="drop__bg" src={heroVideo} autoplay muted loop playsinline aria-hidden="true"></video>}
  {(heroBanner || heroVideo) && <div class="drop__shade" aria-hidden="true"></div>}
  <div class="drop__inner">
    <p class="drop__phase">{PHASE_LABEL[phase]}</p>
    <h1 class="drop__title">{drop.title}</h1>
    {drop.subtitle && <p class="drop__subtitle">{drop.subtitle}</p>}

    {phase === 'coming_soon' && (
      <>
        <Countdown targetIso={drop.preorder_starts_at} label="Pré-venda abre em" />
        <p class="drop__text">A pré-venda é só para convidados. Entre na lista para ser avisado quando abrir.</p>
        <LeadForm source="presave" cta="Quero ser avisado" successMessage="Anotado! Avisamos por e-mail." />
      </>
    )}

    {phase === 'presale' && (
      <>
        <p class="drop__text">
          Pré-venda exclusiva para convidados: até 2 peças de cada produto por pessoa. Produção em até {drop.production_days} dias,
          mais o prazo da transportadora.
        </p>
        {access === 'login' && (
          <>
            <p class="drop__text drop__text--muted">Digite seu e-mail: se já tiver conta, pedimos a senha; se não, enviamos seu acesso à pré-venda.</p>
            <AccessForm cta="Continuar" />
          </>
        )}
        {access === 'locked' && (
          <>
            <p class="drop__text drop__text--muted">Esta conta ainda não tem convite para este drop. Peça acesso e avisamos se liberarmos.</p>
            <LeadForm source="pedir_acesso" cta="Pedir acesso" successMessage="Pedido enviado! Avisamos por e-mail." />
          </>
        )}
      </>
    )}

    {phase === 'general' && (
      <>
        <p class="drop__text">
          Venda geral aberta para todos, enquanto durar o lote. Produção em até {drop.production_days} dias, mais o prazo da
          transportadora.
        </p>
      </>
    )}

    {phase === 'ended' && (
      <>
        <p class="drop__text">Este drop encerrou. Entre na lista e seja o primeiro a saber do próximo.</p>
        <LeadForm source="signup" cta="Entrar na lista" successMessage="Você está na lista do próximo drop!" />
        <div class="drop__links">
          {drop.instagram_url && <a href={drop.instagram_url} target="_blank" rel="noopener">Instagram</a>}
          {drop.whatsapp_url && <a href={drop.whatsapp_url} target="_blank" rel="noopener">Grupo do WhatsApp</a>}
        </div>
      </>
    )}
  </div>
</section>
)}

<style>
  .dc { padding-bottom: 64px; color: #fff; }
  .dc .container { max-width: var(--max-w, 1200px); margin-inline: auto; width: 100%; box-sizing: border-box; }
  .dc-banner { position: relative; min-height: min(56vh, 520px); display: flex; align-items: flex-end; overflow: hidden; margin-bottom: 48px; }
  .dc-banner__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 25%; }
  .dc-banner__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, 0.88) 0%, rgba(0, 0, 0, 0.35) 55%, rgba(0, 0, 0, 0.15) 100%); }
  .dc-banner__content { position: relative; z-index: 1; padding-top: calc(var(--header-h) + 24px); padding-bottom: 40px; }
  .dc-banner__eyebrow { font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-accent); margin: 0 0 8px; }
  .dc-banner__title { font-family: var(--font-title); font-size: clamp(40px, 7vw, 84px); text-transform: uppercase; line-height: 0.95; margin: 0 0 14px; max-width: 16ch; }
  .dc-banner__desc { max-width: 56ch; font-size: 15px; line-height: 1.55; color: rgba(255, 255, 255, 0.82); margin: 0 0 12px; }
  .dc-banner__count { margin: 0; font-size: 13px; font-weight: 600; color: rgba(255, 255, 255, 0.7); }
  .dc-mosaic { display: flex; flex-direction: column; }
  .dc-section { margin-top: 40px; }
  .dc-section__band--full { width: 100%; }
  .drop { position: relative; overflow: hidden; min-height: 70vh; display: grid; place-items: center; padding: 120px 20px 80px; text-align: center; color: #fff; }
  .drop--presale, .drop--general { min-height: 0; padding-bottom: 56px; }
  .drop__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .drop__shade { position: absolute; inset: 0; background: linear-gradient(rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.75)); }
  .drop__inner { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 22px; max-width: 640px; }
  .drop__phase { margin: 0; font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-accent, #e77e23); }
  .drop__title { margin: 0; font-family: var(--font-title); font-size: clamp(48px, 10vw, 96px); line-height: 0.95; text-transform: uppercase; }
  .drop__subtitle { margin: 0; font-size: 18px; color: rgba(255, 255, 255, 0.75); }
  .drop__text { margin: 0; font-size: 15px; line-height: 1.6; color: rgba(255, 255, 255, 0.8); }
  .drop__text--muted { color: rgba(255, 255, 255, 0.55); font-size: 13px; }
  .drop__inner .drop__btn { padding: 14px 24px; border: 0; border-radius: 8px; background: var(--c-accent, #e77e23); color: #fff; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; font-size: 13px; cursor: pointer; }
  .drop__links { display: flex; gap: 20px; }
  .drop__links a { color: var(--c-accent, #e77e23); font-weight: 700; text-decoration: none; }
  .drop__links a:hover { text-decoration: underline; }
</style>

<script>
  import { syncSessionCookie } from '../../lib/session';

  // O servidor só enxerga a sessão pelo cookie: se o login/logout mudou o token, espelha e recarrega uma vez.
  const resync = () => {
    if (syncSessionCookie()) location.reload();
  };
  resync();
  window.addEventListener('tyer:auth', resync);
</script>
