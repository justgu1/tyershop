---
import { t, getPathForLang, type Lang } from '../i18n/utils';
import { getProductVariantData } from '../lib/product-variants';
import { getVariantPriceInfo } from '../lib/medusa-pricing';
import { optionRowKind } from '../lib/variant-option-ui';
import { getVariantSlideUrls } from '../lib/product-variant-gallery';

interface Props {
  product: any;
  lang?: Lang;
  reverse?: boolean;
}

const { product, lang = 'pt', reverse = false } = Astro.props;

const {
  stockReliable: stockSignalsAreReliable,
  normalizedVariants: normalizedVariantsRaw,
  optionRows,
  defaultVariant,
} = getProductVariantData(product);
const colorRow = optionRows.find((row: { title: string }) => optionRowKind(row.title) === 'color');
const sizeRows = optionRows.filter((row: { title: string }) => optionRowKind(row.title) === 'size');
const otherOptRows = optionRows.filter(
  (row: { title: string }) => optionRowKind(row.title) !== 'color' && optionRowKind(row.title) !== 'size'
);

/* Mesmo remapeamento de ProductCard.astro — `allow_backorder` não vem no
   normalizado padrão, precisa cruzar com o variant raw pra saber se um
   combo "esgotado" ainda pode ser vendido. Serializado como data-variants
   pro client resolver a combinação cor+tamanho de verdade (não só cor). */
const rawVariants = product.variants ?? [];
const normalizedVariants = normalizedVariantsRaw.map((nv: any) => {
  const raw = rawVariants.find((v: any) => String(v?.id) === String(nv.id));
  return { ...nv, allowBackorder: raw?.allow_backorder === true };
});

const handle = product.handle ?? '';
const title = product.title ?? '';

/** 1 variante representante por cor (a troca de cor no mosaico não usa tamanho). */
function pickVariantForColor(colorValue: string) {
  const inColor = normalizedVariants.filter((v) => v.options?.[colorRow!.id] === colorValue);
  return inColor.find((v) => !v.soldOut) ?? inColor[0] ?? defaultVariant;
}

/* `defaultVariant` é o objeto raw da Medusa (options[] em array), não o
   normalizado (options{} em mapa) — precisa achar o normalizado equivalente. */
const defaultNormalized = normalizedVariants.find((v) => v.id === defaultVariant?.id);
const activeColor = colorRow ? String(defaultNormalized?.options?.[colorRow.id] ?? '') : '';

/* `v` aqui é o normalizado (options{} em mapa, sem metadata/thumbnail) —
   `getVariantSlideUrls(v, product)` nesse shape só enxerga `v.images`
   (o par primary+secondary do hover do ProductCard, sempre 2), nunca o
   `variant_gallery` de verdade (que só existe no objeto raw). O próprio
   normalizador já resolve isso certo a partir do raw e expõe pronto em
   `v.slideUrls` — usar direto em vez de recalcular errado. Bug real:
   toda cor vinha travada em 2 fotos mesmo tendo 7-8 no metadata. */
const colorVariants = colorRow
  ? colorRow.values.map((val: string) => {
      const v = pickVariantForColor(val);
      const slides = [...new Set(v.slideUrls ?? [])].slice(0, 5);
      return { value: val, variant: v, slides: slides.length ? slides : ['/no-data.webp'] };
    })
  : [];

const priceInfo = getVariantPriceInfo(defaultVariant);
const activeSlides = colorRow
  ? colorVariants.find((c) => c.value === activeColor)?.slides ?? []
  : [...new Set(getVariantSlideUrls(defaultVariant, product))];
// A foto principal de cada cor abre o mosaico; depois vêm as demais da cor ativa.
const galleryUrls = [...new Set([...colorVariants.map((c) => c.slides[0]), ...activeSlides])].filter(Boolean).slice(0, 5);
if (!galleryUrls.length) galleryUrls.push('/no-data.webp');

/* DOM precisa de slots suficientes p/ cobrir a cor com mais fotos — trocar de cor
   só liga/desliga slots e troca src, nunca recria nó (CSS scoped não pega em injectHTML). */
const maxTileCount = Math.min(
  5,
  Math.max(galleryUrls.length, ...colorVariants.map((c) => c.slides.length), 1)
);
const tileSlots = Array.from({ length: maxTileCount }, (_, i) => galleryUrls[i] ?? null);

/* Parágrafos da descrição (o HTML do admin vira texto puro), no máximo 2 e ~320 caracteres, cortando no fim de uma frase. */
const MAX_DESC = 320;
const descriptionParagraphs = String(product.description ?? '')
  .split(/<\/p>|<br\s*\/?>|\n{2,}/i)
  .map((part) => part.replace(/<[^>]+>/g, ' ').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim())
  .filter(Boolean)
  .slice(0, 2)
  .reduce<string[]>((acc, part) => {
    const used = acc.join(' ').length;
    if (used >= MAX_DESC) return acc;
    if (used + part.length <= MAX_DESC) return [...acc, part];
    const cut = part.slice(0, MAX_DESC - used);
    const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! '), cut.lastIndexOf('? '));
    return [...acc, end > 40 ? cut.slice(0, end + 1) : cut.replace(/\s+\S*$/, '') + '…'];
  }, []);

/* Cor já é resolvida pelo swatch (1 variante representante); tamanho/outros
   precisam do mesmo mecanismo do ProductCard — mapa options->valor do
   defaultVariant, e os dados completos serializados pro client cruzar a
   combinação escolhida (cor + tamanho) com a variante de verdade. */
const selectedByOption = Object.fromEntries(
  (defaultVariant?.options ?? []).map((opt: any) => [String(opt.option_id ?? opt.id ?? ''), String(opt.value ?? '')])
);
---

<article
  class:list={['mosaic-item', { 'mosaic-item--reverse': reverse }]}
  data-mosaic-item
  data-stock-reliable={stockSignalsAreReliable ? 'true' : 'false'}
  data-product-id={product.id ?? ''}
  data-product-handle={handle}
  data-product-title={title}
  data-variants={encodeURIComponent(JSON.stringify(normalizedVariants))}
  data-option-rows={encodeURIComponent(JSON.stringify(optionRows))}
>
  <a
    href={getPathForLang(`/product/${handle}`, lang)}
    class="mosaic-item__gallery"
    data-count={galleryUrls.length}
    data-gallery
    aria-label={title}
  >
    {tileSlots.map((url, i) => (
      <span class:list={['mosaic-item__tile', { 'mosaic-item__tile--main': i === 0 }]} hidden={url == null} data-tile>
        <img
          src={url ?? '/no-data.webp'}
          alt={i === 0 ? title : ''}
          class="mosaic-item__img"
          loading="lazy"
          decoding="async"
          aria-hidden={i === 0 ? undefined : 'true'}
          onerror="this.onerror=null;this.src='/no-data.webp'"
        />
      </span>
    ))}
  </a>

  <div class="mosaic-item__info">
    <a href={getPathForLang(`/product/${handle}`, lang)} class="mosaic-item__title-link">
      <h3 class="mosaic-item__title">{title}</h3>
    </a>

    {descriptionParagraphs.length > 0 && (
      <div class="mosaic-item__desc">{descriptionParagraphs.map((text) => <p>{text}</p>)}</div>
    )}

    <div class="mosaic-item__footer">
      <div class="mosaic-item__price-box" data-price-box>
        <span class="mosaic-item__price-striked" data-price-striked hidden={!priceInfo?.originalDisplay}>{priceInfo?.originalDisplay ?? ''}</span>
        <span class="mosaic-item__price" data-price-current>{priceInfo?.display ?? ''}</span>
      </div>
      <div class="mosaic-item__actions">
        <a href={getPathForLang(`/product/${handle}`, lang)} class="btn btn-outline mosaic-item__view">
          {t(lang, 'shop', 'view_product') || 'Ver produto'}
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  .mosaic-item {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 40px;
    align-items: center;
    padding-block: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .mosaic-item--reverse {
    grid-template-columns: 1fr 1.15fr;
  }
  .mosaic-item--reverse .mosaic-item__gallery {
    order: 2;
  }

  /* Mosaico real: sem crop nem deformação (object-fit: contain), grid denso.
     1 imagem → tile único. 2+ → 1 grande + resto em blocos menores. */
  .mosaic-item__gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 1fr;
    grid-auto-flow: dense;
    gap: 8px;
    border-radius: 12px;
    overflow: hidden;
  }
  .mosaic-item__gallery[data-count='1'] {
    grid-template-columns: 1fr;
  }
  .mosaic-item__tile {
    display: block;
    aspect-ratio: 1 / 1;
    background: var(--c-bg-mute, #1a1a1a);
    overflow: hidden;
  }
  .mosaic-item__tile[hidden] {
    display: none !important;
  }
  .mosaic-item__tile--main {
    grid-column: span 2;
    grid-row: span 2;
  }
  .mosaic-item__gallery[data-count='1'] .mosaic-item__tile--main {
    grid-column: span 1;
    aspect-ratio: 16 / 10;
  }
  .mosaic-item__gallery[data-count='2'] .mosaic-item__tile {
    grid-column: span 2;
    grid-row: span 1;
    aspect-ratio: 1 / 1;
  }
  /* 3 e 4 fotos deixavam metade de uma linha vazia: as sobras ocupam a coluna direita inteira. */
  .mosaic-item__gallery[data-count='3'] .mosaic-item__tile:not(.mosaic-item__tile--main),
  .mosaic-item__gallery[data-count='4'] .mosaic-item__tile:nth-child(4) {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }
  .mosaic-item__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    transition: transform 0.4s ease;
  }
  .mosaic-item__tile:hover .mosaic-item__img {
    transform: scale(1.04);
  }

  .mosaic-item__info {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .mosaic-item__title-link {
    text-decoration: none;
  }
  .mosaic-item__title {
    font-family: var(--font-title);
    font-size: clamp(24px, 3vw, 36px);
    text-transform: uppercase;
    line-height: 1.05;
    color: var(--c-text);
    margin: 0;
  }
  .mosaic-item__colors {
    display: flex;
    gap: 8px;
  }
  .mosaic-item__swatch {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0;
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .mosaic-item__swatch:hover {
    border-color: rgba(255, 255, 255, 0.5);
  }
  .mosaic-item__swatch.is-active {
    border-color: var(--c-accent);
    transform: scale(1.08);
  }
  .mosaic-item__swatch-inner {
    display: block;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid rgba(0, 0, 0, 0.12);
  }
  .mosaic-item__swatch-inner--neutral {
    background-color: #9ca3af;
  }
  .mosaic-item__desc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-size: 15px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.85);
    max-width: 56ch;
  }
  .mosaic-item__desc p { margin: 0; }
  .mosaic-item__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 8px;
  }
  .mosaic-item__price-box {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .mosaic-item__price-striked {
    font-size: 13px;
    text-decoration: line-through;
    color: var(--c-muted);
  }
  .mosaic-item__price {
    font-size: 22px;
    font-weight: 800;
    color: var(--c-text);
  }
  .mosaic-item__actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .mosaic-item__view {
    padding: 10px 18px;
    font-size: 12px;
  }
  /* `.pc__quick-add` (classe extra no botão) só serve pra cair na delegação
     global de clique em product-card-client.ts — o visual é todo daqui, já
     que o CSS scoped do ProductCard não alcança este componente. */
  .mosaic-item__add {
    width: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--c-accent);
    border: 1px solid var(--c-accent);
    border-radius: var(--r-md, 8px);
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .mosaic-item__add:hover {
    background: var(--c-accent-d);
    border-color: var(--c-accent-d);
  }
  .mosaic-item__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
  .mosaic-item__add img {
    filter: brightness(0) invert(1);
  }
  .mosaic-item__add :global(.pc__quick-add__label) {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
    white-space: nowrap;
  }

  @media (max-width: 780px) {
    .mosaic-item,
    .mosaic-item--reverse {
      grid-template-columns: 1fr;
      gap: 20px;
      padding-block: 28px;
    }
    .mosaic-item--reverse .mosaic-item__gallery {
      order: 0;
    }

    /* Mobile: mosaico denso vira faixa horizontal com scroll-snap — evita
       blocos minúsculos/espremidos numa tela estreita. */
    .mosaic-item__gallery {
      display: flex;
      grid-template-columns: unset;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 8px;
      border-radius: 10px;
      scrollbar-width: none;
    }
    .mosaic-item__gallery::-webkit-scrollbar {
      display: none;
    }
    .mosaic-item__tile,
    .mosaic-item__tile--main,
    .mosaic-item__gallery[data-count='1'] .mosaic-item__tile--main,
    .mosaic-item__gallery[data-count='2'] .mosaic-item__tile {
      flex: 0 0 78%;
      aspect-ratio: 4 / 5;
      scroll-snap-align: center;
      border-radius: 10px;
    }
  }
</style>
