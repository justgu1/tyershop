---
import { t, getPathForLang, type Lang } from '../i18n/utils';
import { getVariantGalleryUrls } from '../lib/product-variant-gallery';
import { getProductVariantData, getVariantMaxQty, isVariantSoldOut } from '../lib/product-variants';
import VariantOptionRows from './VariantOptionRows.astro';

interface Props {
  product: any;
  lang?: Lang;
  role?: 'article' | 'listitem';
  badges?: {
    isPopular?: boolean;
    isNew?: boolean;
  };
}

const { product, lang = 'pt', role, badges } = Astro.props;

const {
  stockReliable: stockSignalsAreReliable,
  normalizedVariants: normalizedVariantsRaw,
  optionRows,
  defaultVariant,
  defaultVariantTitle,
} = getProductVariantData(product);

const variants = product.variants ?? [];

const normalizedVariants = normalizedVariantsRaw.map(
  ({ images, slideUrls, id, title, price, soldOut, maxQty, options, optionTitles, priceDisplay, originalDisplay, discountPercent }) => {
    const raw = (variants as any[]).find((v) => String(v?.id) === String(id));
    return {
      id,
      title,
      price,
      soldOut,
      maxQty,
      options,
      optionTitles,
      images,
      slideUrls,
      priceDisplay,
      originalDisplay,
      discountPercent,
      allowBackorder: raw?.allow_backorder === true,
    };
  }
);

const priceInfo =
  normalizedVariantsRaw.find((n) => n.id === defaultVariant?.id) ?? normalizedVariantsRaw[0];
const priceVal = priceInfo?.priceDisplay ?? null;
const originalPriceVal = priceInfo?.originalDisplay ?? null;
const priceCents = priceInfo?.price ?? 0;
const isSoldOut = variants.length > 0
  ? variants.every((v: any) => isVariantSoldOut(v, stockSignalsAreReliable))
  : isVariantSoldOut(defaultVariant, stockSignalsAreReliable);
const discountPercent = priceInfo?.discountPercent ?? 0;
const exclusiveMeta = String(product.metadata?.exclusive ?? product.metadata?.is_exclusive ?? '').toLowerCase();
const isExclusive =
  exclusiveMeta === 'true' || exclusiveMeta === '1' || exclusiveMeta === 'yes' || exclusiveMeta === 'sim';
const hasPopularBadge = !!badges?.isPopular;
const hasNewBadge = !!badges?.isNew;
const handle = product.handle ?? '';
const stockNotifyMsgsEnc = encodeURIComponent(
  JSON.stringify({
    ok: t(lang, 'pdp', 'stock_notify_ok'),
    err: t(lang, 'pdp', 'stock_notify_err'),
  })
);

const [thumbRaw] = getVariantGalleryUrls(defaultVariant, product);
const thumb = thumbRaw || '/no-data.webp';

const selectedDefaultByOption = Object.fromEntries(
  (defaultVariant?.options ?? []).map((opt: any) => [String(opt.option_id ?? opt.id ?? ''), String(opt.value ?? '')])
);
---

<article
  class="pc"
  role={role ?? 'article'}
  data-stock-reliable={stockSignalsAreReliable ? 'true' : 'false'}
  data-product-id={product.id ?? ''}
  data-product-handle={handle}
  data-product-title={product.title ?? ''}
  data-stock-notify-msgs={stockNotifyMsgsEnc}
  data-variants={encodeURIComponent(JSON.stringify(normalizedVariants))}
  data-option-rows={encodeURIComponent(JSON.stringify(optionRows))}
>
  <div class="pc__img-wrap">
    <a href={getPathForLang(`/product/${handle}`, lang)} class="pc__link" aria-label={product.title}>
      <img
        src={thumb}
        alt={product.title ?? ''}
        class="pc__img pc__img--primary"
        width="480"
        height="480"
        loading="lazy"
        decoding="async"
        onerror="this.onerror=null;this.src='/no-data.webp'"
      />
      <div class="pc__tags pc__tags--priority">
        <span class="pc__tag pc__tag--soldout" data-pc-soldout-tag hidden={!isSoldOut}>
          <img src="/icons/cross.svg" alt="" width="12" height="12" />
          Esgotado
        </span>
        <span class="pc__tag pc__tag--discount" data-pc-discount-tag style={!isSoldOut && discountPercent > 0 ? undefined : 'display:none'}>
          {discountPercent > 0 ? `${discountPercent}% off` : ''}
        </span>
      </div>
      <div class="pc__tags pc__tags--category" data-pc-category-tags hidden={isSoldOut}>
        {isExclusive && <span class="pc__tag pc__tag--exclusive">Exclusivo</span>}
        {hasPopularBadge && (
          <span class="pc__tag pc__tag--popular">
            <img src="/icons/em-alta.svg" alt="" width="12" height="12" />
            Em alta
          </span>
        )}
        {hasNewBadge && (
          <span class="pc__tag pc__tag--new">
            <img src="/icons/novo.svg" alt="" width="12" height="12" />
            Novo
          </span>
        )}
      </div>
    </a>
    <button type="button" class="pc__gallery-arrow pc__gallery-arrow--prev" data-gallery-prev aria-label={t(lang, 'pdp', 'prev_slide')} hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <button type="button" class="pc__gallery-arrow pc__gallery-arrow--next" data-gallery-next aria-label={t(lang, 'pdp', 'next_slide')} hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 18 6-6-6-6"/></svg>
    </button>
    <div class="pc__gallery-dots" data-gallery-dots hidden></div>
  </div>

  <div class="pc__body">
    <a href={getPathForLang(`/product/${handle}`, lang)} class="pc__body-link">
      <h3 class="pc__name">{product.title}</h3>
    </a>

    <VariantOptionRows optionRows={optionRows} selectedByOption={selectedDefaultByOption} idPrefix={handle} />

    <div class="pc__bottom">
      <div class:list={['pc__price-box', { 'pc__price-box--discount': discountPercent > 0 }]}>
        <span class="pc__price-striked" hidden={!originalPriceVal}>{originalPriceVal ?? ''}</span>
        {priceVal && <span class="pc__price-current">{priceVal}</span>}
      </div>

      <button
        type="button"
        class="pc__quick-add"
        data-variant-id={defaultVariant?.id}
        data-title={product.title}
        data-price={priceCents ?? ''}
        data-thumbnail={thumb}
        data-variant-title={defaultVariantTitle}
        data-max-qty={getVariantMaxQty(defaultVariant) ?? ''}
        disabled={isSoldOut}
        aria-label={`${t(lang, 'product', 'add_to_cart')} — ${product.title}`}
      >
        <img src="/icons/bag.svg" alt="" width="18" height="18" />
        <span class="pc__quick-add__label">{t(lang, 'product', 'add_to_cart')}</span>
      </button>
    </div>

    <div class="pc__stock-notify" hidden>
      <p class="pc__stock-notify__intro">{t(lang, 'pdp', 'stock_notify_intro')}</p>
      <div class="pc__stock-notify__row">
        <input
          type="email"
          class="pc__stock-notify__input"
          autocomplete="email"
          inputmode="email"
          placeholder="email@exemplo.com"
          aria-label={t(lang, 'pdp', 'stock_notify_email_aria')}
        />
        <button type="button" class="btn btn-outline pc__stock-notify__btn">
          {t(lang, 'pdp', 'stock_notify_cta')}
        </button>
      </div>
      <p class="pc__stock-notify__feedback" hidden role="status"></p>
    </div>
  </div>
</article>

<style>
.pc {
  display: flex;
  flex-direction: column;
  position: relative;
  /* `align-items: stretch` do container (flex ou grid) só estica um item
     cujo `height` especificado seja `auto` — com `height: 100%` (valor
     explícito, mesmo que indefinido contra um ancestral sem altura
     definida) o stretch é ignorado e o card fica na altura do próprio
     conteúdo. É por isso que cards sem linha de variante de cor saem mais
     baixos que os com cor, com botão/preço subindo, no carousel mobile da
     home e em qualquer fileira que dependa desse stretch. `min-height`
     não sofre essa restrição — faz o mesmo papel sem quebrar o stretch. */
  height: auto;
  min-height: 100%;
  transition: transform 0.3s ease;
}
.pc:hover {
  transform: translateY(-4px);
}
.pc__link {
  display: block;
}
.pc__img-wrap {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--c-bg-mute, #1a1a1a);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 8px;
  margin-bottom: 12px;
  /* Deixa o scroll vertical da página livre; o arrasto horizontal é pego
     pelo JS (troca de foto da galeria), sem repassar pro carousel externo. */
  touch-action: pan-y;
}
.pc__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.15s ease, filter 0.15s ease;
}
.pc:hover .pc__img {
  transform: scale(1.06);
}
.pc__img--primary.is-swapping {
  opacity: 0;
}
.pc__gallery-arrow {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 2;
  width: 26px;
  height: 26px;
  border-radius: 50%;
  border: 0;
  background: rgba(10, 10, 10, 0.55);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transition: opacity 0.15s ease, background 0.15s ease;
}
.pc__img-wrap:hover .pc__gallery-arrow {
  opacity: 1;
}
/* :hover nunca dispara em touch — sem isso as setas ficam invisíveis (e
   inalcançáveis) em telas touch, mesmo sendo a alternativa "clicável" ao
   swipe pra quem usa teclado/leitor de tela ou não faz o gesto certo. */
@media (pointer: coarse) {
  .pc__gallery-arrow {
    opacity: 0.85;
  }
}
.pc__gallery-arrow:hover {
  background: rgba(10, 10, 10, 0.85);
}
.pc__gallery-arrow--prev {
  left: 8px;
}
.pc__gallery-arrow--next {
  right: 8px;
}
.pc__gallery-dots {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 8px;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;
}
/* Os <span> dos dots são injetados via innerHTML no client (product-card-client.ts) —
   não existem no template em build time, então o Astro não estampa o data-cid do
   escopo neles; sem :global() essas regras nunca bateriam. */
.pc__gallery-dots :global(span) {
  width: 12px;
  height: 2.5px;
  border-radius: 2px;
  background: rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
  transition: background 0.15s ease, width 0.15s ease;
}
.pc__gallery-dots :global(span.is-active) {
  background: var(--c-accent, #e77e23);
  width: 18px;
}

.pc__tags {
  position: absolute;
  left: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}
.pc__tags--priority {
  top: 8px;
}
.pc__tags--category {
  top: 8px;
  left: auto;
  right: 8px;
  align-items: flex-end;
}
.pc__tag {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: var(--r);
  color: #fff;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}
/* `display: flex/inline-flex` acima é regra de autor e ganha do `[hidden]` da
   UA stylesheet (origem de autor sempre vence UA, specificity não importa aqui)
   — sem isso, tag/wrapper marcados hidden continuavam visíveis. */
.pc__tag[hidden],
.pc__tags[hidden] {
  display: none !important;
}
.pc__tag--soldout {
  background: #000;
}
.pc__tag--discount {
  background: #16a34a;
}
.pc__tag--exclusive {
  background: #0a0a0a;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.12);
}
.pc__tag--popular {
  background: #0a0a0a;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.12);
}
.pc__tag--popular img {
  filter: brightness(0) invert(1);
  opacity: 0.95;
}
.pc__tag--new {
  background: #0a0a0a;
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.12);
}
.pc__tag--new img {
  filter: brightness(0) invert(1);
  opacity: 0.95;
}

.pc__body {
  text-align: left;
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
}
.pc__body-link {
  text-decoration: none;
  display: block;
}
.pc__name {
  font-size: 14px;
  font-weight: 500;
  line-height: 1.3;
  color: var(--pc-name-color, var(--c-text));
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 2.6em;
}

/* .pc__variant* migrou pra VariantOptionRows.astro (reaproveitado também
   no CollectionMosaicItem, tela de drop) — CSS mora lá agora. */

.pc__bottom {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 10px;
  margin-top: auto;
  padding-bottom: 6px;
}
.pc__bottom--oos .pc__price-box,
.pc__bottom--oos .pc__quick-add {
  display: none;
}

.pc__stock-notify {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid var(--pc-divider, rgba(255, 255, 255, 0.08));
}
.pc__stock-notify__intro {
  margin: 0 0 8px;
  font-size: 12px;
  line-height: 1.35;
  color: var(--pc-muted-text, rgba(255, 255, 255, 0.72));
}
.pc__stock-notify__row {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: stretch;
}
.pc__stock-notify__input {
  width: 100%;
  min-width: 0;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid rgba(0, 0, 0, 0.15);
  background: #fff;
  color: #0a0a0a;
  font-size: 13px;
}
.pc__stock-notify__input::placeholder {
  color: rgba(0, 0, 0, 0.4);
}
.pc__stock-notify__btn {
  width: 100%;
  padding: 10px 14px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  background: var(--c-accent);
  border: 1px solid var(--c-accent);
  color: #fff;
  border-radius: var(--r-md, 8px);
  cursor: pointer;
  transition: background 0.15s ease, border-color 0.15s ease;
}
.pc__stock-notify__btn:hover {
  background: var(--c-accent-d);
  border-color: var(--c-accent-d);
}
.pc__stock-notify__feedback {
  margin: 8px 0 0;
  font-size: 12px;
}
.pc__stock-notify__feedback.is-ok {
  color: var(--pc-ok-text, #7dffb2);
}
.pc__stock-notify__feedback.is-err {
  color: var(--pc-err-text, #ff8a8a);
}

.pc__price-box {
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  flex-wrap: wrap;
  min-height: 20px;
}
.pc__price-striked {
  font-size: 12px;
  text-decoration: line-through;
  color: var(--pc-price-striked, rgba(255, 255, 255, 0.58));
  line-height: 1;
}
.pc__price-current {
  font-size: 16px;
  font-weight: 800;
  color: var(--pc-price-current, #fff);
  line-height: 1;
}
.pc__price-box--discount .pc__price-current {
  color: var(--c-accent);
}

.pc__quick-add {
  position: static;
  transform: none;
  width: 100%;
  background: var(--c-accent);
  border: 1px solid var(--c-accent);
  border-radius: var(--r-md, 8px);
  padding: 10px 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
  flex-shrink: 0;
}
.pc__quick-add__label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #fff;
  white-space: nowrap;
}
.pc__quick-add img {
  filter: brightness(0) invert(1);
  opacity: 1;
}
.pc__quick-add:hover {
  background: var(--c-accent-d);
  border-color: var(--c-accent-d);
}
.pc__quick-add:hover img {
  filter: brightness(0) invert(1);
  opacity: 1;
}
.pc__quick-add:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  border-color: rgba(248, 113, 113, 0.45);
}
.pc__quick-add:disabled:hover {
  background: #991b1b;
  border-color: #ef4444;
}
</style>
