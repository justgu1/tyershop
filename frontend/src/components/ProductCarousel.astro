---
/**
 * Carousel de produtos único — usado na Home ("Mais Vendidos"), na Loja
 * (linhas de coleção, "Mais novos", "Populares") e na PDP ("Mais novos").
 * Antes cada um tinha sua própria implementação de scroll/setas/CSS,
 * divergentes entre si — este componente existe pra eliminar essa
 * duplicação (mesmo visual, mesmo comportamento, uma correção conserta
 * todo mundo).
 *
 * Título + barra de controle (seta anterior, paginação numerada, seta
 * próxima) logo abaixo do título — nunca sobre a imagem — depois o
 * viewport com scroll horizontal de verdade em qualquer largura.
 */
import ProductCard from './ProductCard.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  products: any[];
  lang: Lang;
  title: string;
  headingId: string;
  ariaLabel?: string;
  cardBadges?: (product: any) => { isPopular?: boolean; isNew?: boolean } | undefined;
  /** Onde o título (e, se coube tudo sem precisar de scroll, os cards
   * também) fica na fileira — "os 3 quadrantes". Default `left` (como já
   * era: título à esquerda, cards colados na esquerda quando cabem
   * todos). `center` centraliza os dois (usado só na Home hoje). */
  align?: 'left' | 'center' | 'right';
}

const { products, lang, title, headingId, ariaLabel, cardBadges, align = 'left' } = Astro.props;
---

<section class="product-carousel" data-carousel data-align={align} aria-labelledby={headingId}>
  <div class="product-carousel__head">
    <h2 class="product-carousel__title" id={headingId}>{title}</h2>
    <slot name="actions" />
  </div>
  <div class="product-carousel__controlbar" data-carousel-controlbar role="group" aria-label="Navegação do carrossel" hidden>
    <button type="button" class="product-carousel__nav product-carousel__nav--prev" data-carousel-prev aria-label="Produto anterior">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
    </button>
    <div class="product-carousel__pager" role="tablist" aria-label="Ir para o produto" data-carousel-pager></div>
    <button type="button" class="product-carousel__nav product-carousel__nav--next" data-carousel-next aria-label="Próximo produto">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
    </button>
  </div>
  <div class="product-carousel__viewport" data-carousel-viewport role="region" aria-label={ariaLabel ?? title} tabindex="0">
    <div class="product-carousel__track" role="list" data-carousel-track>
      {products.map((p) => (
        <div class="product-carousel__cell" role="listitem">
          <ProductCard product={p} lang={lang} role="listitem" badges={cardBadges?.(p)} />
        </div>
      ))}
    </div>
  </div>
  <p class="sr-only" aria-live="polite" data-carousel-live></p>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .product-carousel__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
  }
  /* "3 quadrantes": left (padrão, título à esquerda) / center / right —
     controla o título e, junto com .is-centered no track (JS), também os
     cards quando cabem todos sem precisar de scroll. */
  .product-carousel[data-align="center"] .product-carousel__head {
    justify-content: center;
  }
  .product-carousel[data-align="right"] .product-carousel__head {
    justify-content: flex-end;
  }
  .product-carousel__title {
    font-family: var(--font-title);
    font-size: clamp(22px, 3vw, 32px);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--c-text);
  }
  .product-carousel__controlbar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 16px;
  }
  .product-carousel__controlbar[hidden] {
    display: none !important;
  }
  .product-carousel__nav {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--c-border, rgba(255, 255, 255, 0.16));
    background: transparent;
    color: var(--c-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, opacity 0.15s ease;
  }
  .product-carousel__nav:hover:not(:disabled) {
    border-color: var(--c-accent);
    background: var(--c-surface2, rgba(255, 255, 255, 0.06));
  }
  .product-carousel__nav:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  /* Numerada só faz sentido quando o scroll mostra um card de cada vez
     (mobile) — no desktop vários cards ficam visíveis ao mesmo tempo, o
     número clicado não corresponde a uma posição real de scroll. Setas
     continuam funcionando nos dois. */
  .product-carousel__pager {
    display: none;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (max-width: 640px) {
    .product-carousel__pager {
      display: flex;
    }
  }
  .product-carousel__pager :global(button) {
    min-width: 26px;
    height: 26px;
    padding: 0 4px;
    border-radius: 6px;
    border: 1px solid var(--c-border, rgba(255, 255, 255, 0.16));
    background: transparent;
    color: var(--c-muted, rgba(255, 255, 255, 0.6));
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .product-carousel__pager :global(button:hover) {
    border-color: var(--c-accent);
    color: var(--c-text);
  }
  .product-carousel__pager :global(button.is-active) {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: #000;
  }
  .product-carousel__viewport {
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 4px;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
  }
  .product-carousel__track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 16px;
    width: max-content;
    padding: 2px 2px 10px;
  }
  /* Cabe tudo sem precisar de scroll: `width:max-content` deixa a track do
     tamanho exato do conteúdo, então `justify-content` nela mesma não tem
     espaço sobrando pra centralizar — precisa virar `width:100%` pra
     sobrar espaço e aí sim centralizar os cards dentro. Alternado via JS
     (mesmo cálculo que já esconde a barra de controle quando não rola). */
  .product-carousel__track.is-centered {
    width: 100%;
    justify-content: center;
  }
  .product-carousel__cell {
    flex: 0 0 clamp(200px, 22vw, 260px);
    min-width: 0;
    scroll-snap-align: start;
  }
  /* NÃO forçar height:100% aqui — .pc já resolve `height:auto; min-height:
     100%` no próprio base (ProductCard.astro); `height:100%` explícito
     quebra o align-items:stretch (só funciona quando o valor especificado
     é literalmente `auto`), foi um bug real corrigido nesta mesma sessão. */
  @media (max-width: 640px) {
    .product-carousel__cell {
      flex-basis: clamp(220px, 72vw, 300px);
    }
  }
</style>
